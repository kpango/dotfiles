[
  {
    "name": "DoT/DoQ: allow NextDNS 21553f (all VLANs)",
    "description": "Allow DoT/DoQ (853) only to NextDNS profile 21553f from all Internal networks",
    "enabled": true,
    "action": {
      "type": "ALLOW",
      "allowReturnTraffic": false
    },
    "source": {
      "zone": "Internal"
    },
    "destination": {
      "zone": "External",
      "trafficFilter": {
        "type": "DOMAIN",
        "domainFilter": {
          "type": "DOMAINS",
          "domains": [
            "21553f.dns.nextdns.io"
          ]
        },
        "portFilter": {
          "type": "PORTS",
          "matchOpposite": false,
          "items": [
            {
              "type": "PORT_NUMBER",
              "value": 853
            }
          ]
        }
      }
    },
    "ipProtocolScope": {
      "ipVersion": "IPV4_AND_IPV6",
      "protocolFilter": {
        "type": "PRESET",
        "preset": {
          "name": "TCP_UDP"
        }
      }
    },
    "loggingEnabled": false
  },
