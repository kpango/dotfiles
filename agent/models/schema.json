{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HarnessModelRouting",
  "description": "Abstract model tier mapping configuration for AI coding harnesses",
  "type": "object",
  "required": ["harness", "default_tier", "tiers"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "harness": {
      "type": "string",
      "enum": ["claude", "agy", "omp", "hermes"]
    },
    "default_tier": {
      "type": "string",
      "enum": ["Low", "Medium", "High", "XHigh", "Max", "Inherit"]
    },
    "tiers": {
      "type": "object",
      "required": ["Low", "Medium", "High", "XHigh", "Max"],
      "properties": {
        "Low": { "$ref": "#/definitions/TierConfig" },
        "Medium": { "$ref": "#/definitions/TierConfig" },
        "High": { "$ref": "#/definitions/TierConfig" },
        "XHigh": { "$ref": "#/definitions/TierConfig" },
        "Max": { "$ref": "#/definitions/TierConfig" },
        "Inherit": { "$ref": "#/definitions/InheritTierConfig" }
      },
      "additionalProperties": false
    },
    "routingPolicy": { "$ref": "#/definitions/RoutingPolicy" }
  },
  "definitions": {
    "RoutingPolicy": {
      "type": "object",
      "description": "Optional cross-tier routing policy. Advisory only: nothing here switches a model by itself.",
      "properties": {
        "openCodeGoQuotaGuard": {
          "type": "object",
          "description": "OpenCode Go subscription quota guard. When measured usage reaches either limit, high-volume subagent fan-out should move to highVolumeSubagentDefault.",
          "properties": {
            "enabled": { "type": "boolean" },
            "fiveHourMaxPct": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "weeklyMaxPct": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "highVolumeSubagentDefault": {
              "type": "string",
              "description": "provider/model id used for high-volume subagent fan-out"
            }
          },
          "required": [
            "enabled",
            "fiveHourMaxPct",
            "weeklyMaxPct",
            "highVolumeSubagentDefault"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "InheritTierConfig": {
      "type": "object",
      "description": "Optional 6th tier: subagent inherits the parent session model (prompt-cache prefix preservation)",
      "properties": {
        "inheritFromParent": { "type": "boolean" },
        "preservePromptCachePrefix": { "type": "boolean" },
        "primary": { "type": "string" },
        "fallback": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "TierConfig": {
      "type": "object",
      "required": ["model"],
      "properties": {
        "model": { "type": "string" },
        "provider": { "type": "string" },
        "effort": {
          "type": "string",
          "enum": ["low", "medium", "high", "xhigh", "max"]
        },
        "max_context_tokens": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum context window tokens supported for this model route"
        },
        "compaction_threshold": {
          "type": "integer",
          "minimum": 1,
          "description": "Pricing Cliff auto-compaction token limit (e.g., 90000 for Haiku 5.5, 250000 for GPT-6.2 family)"
        },
        "description": { "type": "string" },
        "fallbacks": {
          "type": "array",
          "description": "Ordered cascade of fallback models when primary hits rate-limits or token-limits",
          "items": {
            "type": "object",
            "required": ["model"],
            "properties": {
              "model": { "type": "string" },
              "provider": { "type": "string" },
              "effort": {
                "type": "string",
                "enum": ["low", "medium", "high", "xhigh", "max"]
              },
              "max_context_tokens": {
                "type": "integer",
                "minimum": 1,
                "description": "Maximum context window tokens supported for this fallback model"
              },
              "compaction_threshold": {
                "type": "integer",
                "minimum": 1,
                "description": "Pricing Cliff auto-compaction token limit (e.g., 90000 for Haiku 5.5, 250000 for GPT-6.2 family)"
              },
              "trigger": {
                "type": "string",
                "enum": [
                  "rate_limit",
                  "token_exhaustion",
                  "context_overflow",
                  "cost_saver",
                  "unavailability"
                ]
              },
              "description": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "candidates": {
          "type": "array",
          "description": "Multi-candidate evaluation pool for intelligent model routing",
          "items": {
            "type": "object",
            "required": ["model"],
            "properties": {
              "model": { "type": "string" },
              "provider": { "type": "string" },
              "effort": {
                "type": "string",
                "enum": ["low", "medium", "high", "xhigh", "max"]
              },
              "max_context_tokens": {
                "type": "integer",
                "minimum": 1
              },
              "compaction_threshold": {
                "type": "integer",
                "minimum": 1
              },
              "priority": { "type": "integer" },
              "strategy": { "type": "string" },
              "description": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "sub_routes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["model"],
            "properties": {
              "model": { "type": "string" },
              "provider": { "type": "string" },
              "effort": {
                "type": "string",
                "enum": ["low", "medium", "high", "xhigh", "max"]
              },
              "max_context_tokens": {
                "type": "integer",
                "minimum": 1
              },
              "compaction_threshold": {
                "type": "integer",
                "minimum": 1
              },
              "description": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
