{
  "adapters": {
    "dlv": {
      "command": "dlv",
      "args": ["dap"],
      "languages": ["go"],
      "fileTypes": [".go"],
      "rootMarkers": ["go.mod", "go.work"],
      "connectMode": "socket",
      "acceptsDirectoryProgram": true,
      "launchDefaults": {
        "request": "launch",
        "mode": "test"
      },
      "attachDefaults": {
        "request": "attach",
        "mode": "local"
      }
    },
    "lldb-dap": {
      "command": "lldb-dap",
      "args": [],
      "languages": ["cpp", "c", "rust", "zig"],
      "fileTypes": [".cpp", ".cc", ".c", ".rs", ".zig"],
      "rootMarkers": ["Cargo.toml", "CMakeLists.txt", "build.zig"],
      "connectMode": "stdio"
    }
  }
}
