{
  "$schema": "../../models/schema.json",
  "harness": "omp",
  "default_tier": "High",
  "tiers": {
    "Low": {
      "provider": "opencode-go",
      "model": "opencode-go/deepseek-v4.1-flash",
      "effort": "low",
      "max_context_tokens": 131072,
      "description": "OpenCode Go DeepSeek V4.1 Flash (Low) for rapid exploration, repository survey, and semantic search",
      "sub_routes": {
        "web_research": {
          "provider": "antigravity-cli",
          "model": "antigravity-cli/gemini-4-hydrogen",
          "effort": "low",
          "description": "Antigravity CLI Gemini 4 Hydrogen (Low) for web/docs research, RFCs, and semantic search"
        },
        "code_research": {
          "provider": "opencode-go",
          "model": "opencode-go/deepseek-v4.1-flash",
          "effort": "low",
          "max_context_tokens": 131072,
          "description": "OpenCode Go DeepSeek V4.1 Flash for high-throughput repository code scanning"
        }
      },
      "fallbacks": [
        {
          "provider": "anthropic",
          "model": "anthropic/claude-haiku-5-5",
          "effort": "low",
          "compaction_threshold": 90000,
          "trigger": "rate_limit",
          "description": "Claude Haiku 5.5 fallback (Pricing Cliff auto-compaction at 90,000 tokens)"
        },
        {
          "provider": "antigravity-cli",
          "model": "antigravity-cli/gemini-4-hydrogen",
          "effort": "low",
          "trigger": "cost_saver",
          "description": "Antigravity CLI Gemini 4 Hydrogen fast research fallback"
        },
        {
          "provider": "ollama",
          "model": "ollama/gpt-oss-20b",
          "effort": "low",
          "max_context_tokens": 65536,
          "trigger": "token_exhaustion",
          "description": "Local Ollama GPT-OSS 20B zero-cost offline fallback"
        }
      ]
    },
    "Medium": {
      "provider": "opencode-go",
      "model": "opencode-go/kimi-k3.1-pro",
