{
  "$comment": "mcpServers.serena エントリ(docker run ghcr.io/oraios/serena、stdio transport)はこのファイルを正典とする。codegraph/filesystem/memoryのようにExecutor gateway(mcpServers.executor)へは未移行 — stdio transportのローカルcontainerであり、共有httpUrl/serverUrl方式に載せられないため意図的に対象外(agent/README.md「MCPサーバー定義の統合」節・「共通化しないもの」節参照)。agy/settings.json 側の mcpServers.serena にも同一のdocker run定義が手動ミラーとして存在する(2026-09-13時点でbyte-identicalを確認済み)。変更時はこのファイルを先に更新し、settings.json側へ手動反映すること — 自動同期の保証はない(agent/write-scope-rules.jsonの正典/ミラー方式を踏襲。ただし$commentの置き場所自体もそれに倣いmcpServers内ではなくファイルルートに置く — mcpServersはMCPクライアントがサーバー名をキーとして列挙するmapであり、そこに$commentキーを混ぜると文字列値を持つ偽サーバーエントリとして誤解釈されるため)。",
  "mcpServers": {
    "lsp-go": {
      "command": "mcp-language-server",
      "args": ["--workspace", "$PWD", "--lsp", "gopls"],
      "env": {
        "HOME": "$HOME",
        "PWD": "$PWD"
      },
      "timeout": 60000
    },
    "lsp-rust": {
      "command": "mcp-language-server",
      "args": ["--workspace", "$PWD", "--lsp", "rust-analyzer"],
      "env": {
        "HOME": "$HOME",
        "PWD": "$PWD"
      },
      "timeout": 60000
    },
    "k8s-native": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--pull=missing",
        "--cap-drop=ALL",
        "--security-opt",
        "no-new-privileges",
        "--pids-limit",
        "256",
        "--read-only",
        "--network",
        "host",
        "--user",
        "1000:1000",
        "--tmpfs",
        "/tmp:rw,noexec,nosuid,nodev",
        "-v",
        "$HOME/.kube:/home/user/.kube:ro",
        "-e",
        "KUBECONFIG=/home/user/.kube/config",
        "quay.io/manusa/kubernetes_mcp_server:latest"
      ],
      "env": {
        "HOME": "$HOME",
        "PWD": "$PWD"
      },
      "timeout": 60000
    },
    "k8s-cli": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--pull=missing",
        "--cap-drop=ALL",
        "--security-opt",
        "no-new-privileges",
        "--pids-limit",
        "256",
        "--read-only",
        "--network",
        "host",
        "--user",
        "1000:1000",
        "--tmpfs",
        "/tmp:rw,noexec,nosuid,nodev",
        "-v",
        "$HOME/.kube:/home/user/.kube:ro",
        "-e",
        "KUBECONFIG=/home/user/.kube/config",
        "-e",
        "MASK_SECRETS=true",
        "mcp/kubernetes:latest"
      ],
      "env": {
        "HOME": "$HOME",
        "PWD": "$PWD"
      },
      "timeout": 60000
    },
    "serena": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--pull=missing",
        "--cap-drop=ALL",
        "--security-opt",
        "no-new-privileges",
        "--pids-limit",
        "256",
        "--read-only",
        "--network",
        "host",
        "--user",
        "1000:1000",
        "--tmpfs",
        "/tmp:rw,noexec,nosuid,nodev",
        "-v",
        "$PWD:/workspace:ro",
        "-v",
        "$HOME/.serena:/home/user/.serena:rw",
        "-p",
        "9121:9121",
        "-p",
        "24282:24282",
        "-e",
        "SERENA_DOCKER=1",
        "ghcr.io/oraios/serena:latest",
        "serena start-mcp-server",
        "--transport",
        "stdio"
      ],
      "env": {
        "HOME": "$HOME",
        "PWD": "$PWD"
      },
      "timeout": 60000
    },
    "cipher": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--pull=missing",
        "--cap-drop=ALL",
        "--security-opt",
        "no-new-privileges",
        "--pids-limit",
        "512",
        "--read-only",
        "--network",
        "host",
        "--user",
        "1000:1000",
        "--tmpfs",
        "/tmp:rw,noexec,nosuid,nodev",
        "-v",
        "$PWD:/workspace:ro",
        "-v",
        "$HOME/.local/share/cipher:/data:rw",
        "-e",
        "AGY_API_KEY",
        "-e",
        "OPENAI_API_KEY",
        "-e",
        "ANTHROPIC_API_KEY",
        "ghcr.io/campfirein/cipher:latest",
        "cipher",
        "--mode",
        "mcp",
        "--transport",
        "stdio"
      ],
      "env": {
        "HOME": "$HOME",
        "PWD": "$PWD",
        "AGY_API_KEY": "$AGY_API_KEY",
        "OPENAI_API_KEY": "$OPENAI_API_KEY",
        "ANTHROPIC_API_KEY": "$ANTHROPIC_API_KEY"
      },
      "timeout": 90000
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--pull=missing",
        "--cap-drop=ALL",
        "--security-opt",
        "no-new-privileges",
        "--pids-limit",
        "128",
        "--read-only",
        "--network",
        "host",
        "--user",
        "1000:1000",
        "--tmpfs",
        "/tmp:rw,noexec,nosuid,nodev",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server:latest"
      ],
      "env": {
        "HOME": "$HOME",
        "PWD": "$PWD",
        "GITHUB_PERSONAL_ACCESS_TOKEN": "$GITHUB_PERSONAL_ACCESS_TOKEN"
      },
      "timeout": 60000
    },
    "slack": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--pull=missing",
        "--cap-drop=ALL",
        "--security-opt",
        "no-new-privileges",
        "--pids-limit",
        "128",
        "--read-only",
        "--network",
        "host",
        "--user",
        "1000:1000",
        "--tmpfs",
        "/tmp:rw,noexec,nosuid,nodev",
        "-e",
        "SLACK_BOT_TOKEN",
        "-e",
        "SLACK_TEAM_ID",
        "-e",
        "SLACK_CHANNEL_IDS",
        "mcp/slack:latest"
      ],
      "env": {
        "HOME": "$HOME",
        "PWD": "$PWD",
        "SLACK_BOT_TOKEN": "$SLACK_BOT_TOKEN",
        "SLACK_TEAM_ID": "$SLACK_TEAM_ID",
        "SLACK_CHANNEL_IDS": "$SLACK_CHANNEL_IDS"
      },
      "timeout": 60000
    },
    "executor": {
      "serverUrl": "http://127.0.0.1:4788/mcp"
    }
  }
}
