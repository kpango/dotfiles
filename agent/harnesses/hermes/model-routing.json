          "description": "DeepSeek V4.1 Flash for fast code scanning"
        }
      },
      "fallbacks": [
        {
          "provider": "anthropic",
          "model": "anthropic/claude-haiku-5-5",
          "effort": "low",
          "compaction_threshold": 90000,
          "trigger": "rate_limit",
          "description": "Claude Haiku 5.5 fallback (Pricing Cliff auto-compaction at 90,000 tokens)"
        },
        {
          "provider": "ollama",
          "model": "ollama/gpt-oss-20b",
