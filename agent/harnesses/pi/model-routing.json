        {
          "provider": "codex",
          "model": "codex/gpt-6-astra",
          "effort": "high",
          "trigger": "rate_limit",
          "description": "OpenAI GPT-6 Astra cross-provider frontier architectural diagnosis fallback"
        },
        {
          "provider": "antigravity",
          "model": "antigravity/gemini-3.8-flash-high",
          "effort": "max",
          "trigger": "cost_saver",
          "description": "Antigravity Gemini 3.8 Flash (Max effort) budget survival fallback"
        }
      ]
    }
  }
}
