{
  "$schema": "https://pi.dev/schemas/settings.json",
  "defaultProvider": "anthropic",
  "defaultModel": "anthropic/claude-sonnet-5",
  "defaultThinkingLevel": "high",
  "modelThinkingLevels": {
    "anthropic/claude-sonnet-5": "high",
    "anthropic/claude-opus-5": "high",
    "anthropic/claude-fable-5-1": "high",
    "codex/gpt-6-astra": "high",
    "opencode-go/kimi-k3": "high",
    "opencode-go/deepseek-v4-pro": "high",
    "antigravity/gemini-3.8-flash-high": "high",
    "antigravity/gemini-3.8-flash-medium": "medium",
    "antigravity/gemini-3.8-flash-low": "low",
    "opencode-go/qwen3.8-flash": "low"
  },
  "theme": "kpango-dark",
  "externalEditor": "hx",
  "defaultProjectTrust": "always",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 32768
  },
  "branchSummary": {
    "reserveTokens": 16384,
    "skipPrompt": false
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "timeoutMs": 3600000,
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "defaultTools": ["read", "write", "edit", "bash", "grep", "find", "ls"],
  "enableSkillCommands": true,
  "terminal": {
    "showImages": true,
    "imageWidthCells": 60,
    "trueColor": true
  },
  "markdown": {
    "codeBlockIndent": "  ",
    "mermaid": "streaming"
  },
  "sessionDir": "~/.pi/agent/sessions",
  "lastChangelogVersion": "0.84.4",
  "packages": ["npm:pi-antigravity"]
}
