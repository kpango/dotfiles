#!/usr/bin/env bash
# pa-sandbox -- run `prime-agent "$@"` inside a bubblewrap (bwrap) sandbox.
#
# Layer 2 of the two-layer model (CONTEXT.md, primeagent-max-customize Q5):
# layer 1, wired by default, is only the shell guard (zsh/20-dev.zsh exports
# PRIME_AGENT_BASH_COMMAND_PREFIX); the launch-time env allowlist exists only in
# this wrapper (Environment, below). This wrapper is the whole-process jail for
# autonomous / untrusted runs.
#
# Design: ALLOWLIST. Everything is read-only unless explicitly listed rw.
#   - / is bound READ-ONLY; /dev, /tmp and $HOME are empty tmpfs.
#   - ~/.prime/agent: inside, its path is a SANDBOX-PRIVATE tmpfs in which every entry
#     the host has WHEN PA-SANDBOX LISTS IT (once, while building the profile, about a
#     second before the sandbox starts) is bound READ-ONLY at its own path, so nothing an
#     unsandboxed run later executes or trusts -- bin/ kernel-venv/ settings.json
#     auth.json models.json AGENTS.md skills/ machines/ ... -- can be written, removed,
#     renamed or replaced, on the host or inside (a mount point cannot be unlinked or
#     renamed: EBUSY). An entry the host removes between listing and bwrap is skipped
#     (--ro-bind-try), not fatal; one removed in the instant between bwrap's check and its
#     mount fails bwrap's setup before anything runs inside. pa-sandbox then starts over
#     (PA_SANDBOX_SETUP_TRIES launches, default 3). A failed guard probe is retried
#     directly (it runs only fixed commands); a failed real run is retried only when the
#     host-side watcher shows nothing of that launch is left: bwrap created no child, the
#     child was gone before the watcher released it (`exited`), or its recorded namespaces
#     were swept and nothing in them is alive. If no identity could be recorded (e.g. the
#     exited child stayed unreaped past the watcher's bound) the real run ends with rc 70,
#     not retried; see
#     pa_sandbox_watch and pa_sandbox_main. LOCK NAMES (*.lock, *.lock.*) are never bound (see
#     NEW NAMES). Names that are not bound can be created in that tmpfs only:
#     they never reach the host and vanish with the sandbox. prime-agent 0.10.0 needs
#     this (measured): its daemon takes the mkdir locks settings.json.lock/ and
#     auth.json.lock/ even to READ settings (with a read-only root it fails closed:
#     "The daemon model allowlist could not be read"), writes the mcp catalog through a
#     temp file, and creates auth.json / the catalog / models/ when the host has none.
#     Symlinked entries (the installer links skills/agents/AGENTS.md/models.json
#     into the dotfiles checkout) are bound with their target's content (the
#     checkout's agent/ tree is ro-bound at its real path too); a dangling one is
#     absent inside, as it is for the host.
#   - rw ONLY: the explicit state list PA_SANDBOX_AGENT_RW_DIRS (dirs are created
#     on the host before binding) and PA_SANDBOX_AGENT_RW_FILES (bound only if
#     they exist; atomic rename-over of a bind-mounted file fails with EBUSY),
#     plus the workspace (git toplevel of $PWD).
#   - SANDBOX-PRIVATE dirs PA_SANDBOX_AGENT_TMP_DIRS (daemon-workers/, rlm-ledger/): an
#     empty tmpfs each, hiding the host's copy. The sandboxed daemon's supervisor-config
#     and worker state (daemon-workers/<sha256(socket)[:12]>/) and the rlm.spawn /
#     rlm.factory spawn ledger live there and are discarded at exit.
#   - BIND ORDER: tmpfs -> agent tmpfs + its ro entries -> all rw binds and private
#     tmpfs dirs -> all ro (re)binds last, so no rw bind can shadow a protection.
#   - ro re-binds: ~/.local/bin, ~/.local/share/prime-agent, the kernel venv's
#     interpreter (KERNEL VENV INTERPRETER), the guard checkout's agent/ tree, targets of
#     symlinked agent-dir entries, PA_SANDBOX_RO_EXTRA (colon-separated), and the
#     workspace's whole `.git` path (the directory, or the gitfile of a linked
#     worktree, as the mount point itself: it cannot be renamed, replaced or
#     recreated), the linked worktree's validated common dir as a whole, every
#     nested `.git` under the workspace, and every BARE REPO / git dir not named `.git`
#     already in the workspace (a directory holding HEAD next to objects/, refs/ or
#     commondir -- e.g. ws/mirror.git that an outside repo pushes to; found by the same
#     scan, protected and config-scanned exactly like a nested `.git`, counted against
#     the same cap; detected statically, host git is never run in it). Git metadata is therefore
#     entirely READ-ONLY: edits to working-tree files work, but git write
#     operations (commit, branch, add, config) fail BY DESIGN; the human commits on
#     the host after review. Every git dir found this way (the workspace's `.git` or its
#     gitfile's gitdir, nested `.git` dirs, nested gitfile targets, bare repos, and the git
#     dirs below, recursively) AND the `commondir` of each is resolved and
#     ro-bound if inside the workspace, else the run is refused unless it is already
#     under a protected git dir.
#   - SUBMODULE / WORKTREE GIT DIRS: inside each of those git dirs and its common dir, every
#     git dir under `modules/` (submodule git dirs, also of deinitialised submodules; the
#     outermost ones, nested `modules/` are reached through the recursion) and every
#     `worktrees/*` admin dir is handled like a nested `.git` (config scan, symlink and
#     hard-link checks, the same cap). Its worktree root (a base for the config words below)
#     is core.worktree if set, plus: for `modules/<name>` the `submodule.<name>.path` of the
#     superproject root's .gitmodules (read with `git config --file`), else <name>; for
#     `worktrees/<id>` the directory of the path in its `gitdir` file. A path that is
#     absolute or has `.`/`..` components, an unparsable .gitmodules, an admin dir without
#     a gitdir file, a symlinked directory under `modules/` outside every submodule git dir,
#     or any find error refuses. Paths are walked component by component BEFORE
#     normalisation: a symlink inside the writable workspace anywhere on the way (also
#     before a `..`, e.g. `lnk/../meta/gs`) refuses, and so does a `..` that leaves a
#     writable directory (`..` IN GIT PATHS below). ALL nested `.git` entries (no depth
#     limit; symlinks skipped) and bare repos are bound; more than
#     PA_SANDBOX_MAX_NESTED_GIT (500) FAILS CLOSED.
#   - CONFIG REFERENCES: for each of those repos, the common config, config.worktree,
#     and every include.path / includeIf.*.path file (followed recursively by
#     pa-sandbox itself with `git config --file --no-includes`, which only parses; all
#     includeIf targets regardless of their condition; plus the host global/system
#     config files `git var` names -- each is protected like a config reference, a MISSING
#     one too: GIT_CONFIG_GLOBAL=<ws>/conf/gitconfig or $XDG_CONFIG_HOME=<ws>/cfg would let
#     the sandbox create a global config host git trusts) are scanned. There is NO list of path keys: EVERY value
#     of EVERY key is split into words and each word that may name a path is protected
#     (inside the workspace an existing target is ro-bound; a missing one is covered by
#     its ro top-level ancestor, and refuses if it would sit directly under the root):
#       * splitting: a leading `!` is dropped, quotes are removed, `$HOME`/`${HOME}` mean
#         `~`, any other `$VAR`/`${...}`/`$(`/`)`/backquote ends a word, and
#         ; & | < > ( ) { } and whitespace separate words, `=` and `,` split a word into
#         pieces. With unbalanced quotes the whole value is a word as well.
#       * VALUE CANDIDATES: besides each word/piece, the word with its `=` `,` kept, the value
#         of an attached short option (`-Fsshconf` -> sshconf; `--opt=x` gives the piece x)
#         and the whole value (trimmed, a leading `:(optional)` dropped) are candidates;
#         these count only when they EXIST, except under SINGLE WORDS below.
#       * a word with `/` is a path: absolute, `~/` (host HOME), or relative to every base
#         (each worktree root -- the repo root, a nested repo's root, core.worktree -- and
#         the directory of the config file that set it). A word that followed a `$...`
#         expansion (`$(git rev-parse --show-toplevel)/x`) is also tried relative to each
#         base. A word WITHOUT `/` is protected when it names an existing file, directory
#         or symlink relative to a base. A MISSING word without `/` counts as well (like
#         `./word`: refused directly under a root, else its top-level ancestor is ro) when a
#         shell/interpreter would open it relative to the current directory: every word
#         after a command named sh/bash/zsh/python*/perl*/ruby*/node/awk/sed/source/`.`/go/
#         uv/npx/... (the ireg list), after a wrapper (env/exec/timeout/xargs/... -- the wreg
#         list; options, numbers, VAR=x and interpreter names skipped), after a command that
#         is itself an expansion (`$EDITOR x`), or a redirection before the command (`<x sh`).
#         Commands are split at ; & | newline $( ` ( { and nested ones are tracked. Such a
#         word that is an expansion (`sh $HOOK`, `sh "$1"`) cannot be resolved and refuses.
#         Options (-x) and git placeholders (%f) are skipped.
#       * SINGLE WORDS: a value that is exactly ONE word (no whitespace, no leading `!`, not
#         `%(prefix)/...`; `,` `=` inside are part of it) is a path even when missing, like
#         `./word` above (gpg.ssh.allowedSignersFile = allowed_signers, http.sslCAInfo =
#         ca.pem, init.templateDir = tmpl; git resolves them against the current directory).
#         This holds for every key, including keys unknown to pa-sandbox, EXCEPT (_nonpath;
#         the reason per key class is under KNOWN LIMITS (a)): an option word (-x) or a GPG
#         key id (8-40 hex digits), but not for a path-type key name (*file, *path, *dir,
#         *.ssl*, *.template, gc.repackFilterTo: git opens such a value as a file); a key
#         whose value is a COMMAND name (alias.*, *.editor, core.pager, pager.*, *.program,
#         *.cmd, *.textconv, ...); a name, e-mail, enum or ref/branch name (user.name,
#         *.name, credential.*, url.*, branch.* other than the remote keys, color.*, push.*,
#         gc.*, ...; the full list is _nonpath). A key missing from those lists fails
#         closed (a false refusal names the key).
#       * PRINCIPLE: what is PROTECTED is the union of every config file read (includeIf
#         targets whatever their condition, config.worktree with or without
#         extensions.worktreeConfig); what is EXCLUDED because of other config (remote
#         names) is decided by host git itself, never by that union.
#       * REMOTE NAMES: every name host git may know for a git dir -- the values of
#         branch.*.remote, branch.*.pushRemote, remote.pushDefault, checkout.defaultRemote,
#         extensions.partialClone; the names `git remote` lists; the <name> of every
#         remote.<name>.* key in the union of config files read; every file under the
#         legacy remotes/ and branches/ dirs of the git dir and of its common dir (a
#         symlink, special file or scan error there refuses; both dirs sit inside the
#         read-only git dir, so the sandbox cannot add one); every word of every
#         remotes.<group> value in that union (split like git: space, tab, newline; `git
#         fetch <group>` and `git remote update [<group>]` -- remotes.default -- fetch each)
#         and every <group> itself -- host git resolves the name,
#         read-only, per git dir (_gq: `git --git-dir=<dir> -c core.fsmonitor=false remote
#         get-url [--push] --all -- <name>` run from /, with the caller's HOME and
#         GIT_CONFIG_* and no GIT_DIR/GIT_WORK_TREE/GIT_COMMON_DIR; these commands only
#         parse config, no hook/pager/fsmonitor/filter runs). Exit 2 (no such remote): the
#         name is a path itself, like a SINGLE WORD, except a <group> (or a word that is
#         one) for which host git (`git config --get-all remotes.<group>`, same _gq) reads 2
#         or more members: fetch expands it (with 0 or 1 member `git fetch <group>` uses the
#         name itself as the remote / URL). Otherwise every fetch/push URL git
#         returns (after insteadOf; an empty or reset url makes git return the name
#         itself) that is LOCAL (file:// with an empty or `localhost` host -- see KNOWN
#         LIMITS FILE URLS WITH A HOST --, or no `<scheme>://` / `<helper>::` and no `:`
#         before the first `/`) is protected like an interpreter argument (missing too);
#         a remote URL is no path. A git dir for which `git remote` fails (host git does
#         not accept it, e.g. an empty nested .git) has no remotes: every name is a path
#         and nothing is excluded; any other `get-url` error refuses. remotes.* values are
#         handled only here (not as CONFIG REFERENCES / SINGLE WORDS). The other keys
#         git-config(1) lists with a remote name as value (git 2.54, master 2026-10) name a
#         remote git CREATES, not one it resolves: clone.defaultRemoteName, the `name=`
#         prefix of promisor.acceptFromServerUrl.
#       * url.<base>.insteadOf / pushInsteadOf: a <base> (in the KEY) that is a local path
#         (the REMOTE NAMES rule: file:// with an empty or `localhost` host, or no
#         `<scheme>://` / `<helper>::` and no `:`
#         before the first `/`; `a..b` inside does not make it a revision range here) turns a
#         remote into the string base+suffix; a relative or EMPTY one (git then uses the typed
#         suffix itself, relative to the current directory), or one that is a prefix of /
#         inside the workspace or an rw state path, refuses. An absolute one (file:// path
#         part, `~/` = host HOME) is walked as written for `..` IN GIT PATHS (label
#         "url.<base>.insteadof in the config of '<git dir>': '<base>'"): <ws>/sub/../../b/
#         refuses although it normalises to outside the workspace.
#       * core.hooksPath is always a path (even without `/`, even missing); every
#         include target is protected relative to its including file.
#       * NOT treated as paths (exclusion rules): empty values, true/false/yes/no/on/off,
#         numbers (optionally k/m/g), values starting `key::` (literal SSH signing key);
#         words with a URL scheme `xxx://` (file:// is NOT excluded: its path part is
#         protected like an absolute word; file://host/... with another host is skipped
#         although git opens its path -- KNOWN LIMITS FILE URLS WITH A HOST),
#         words with a `:` before any `/` (scp-like remote `host:path`, refspec `a:b`,
#         `format:`), words starting `refs/`, `+refs/` or `^refs/` (refnames/refspecs),
#         words containing a revision range `a..b`, `<remote>/...` (not as an interpreter
#         argument) when <remote> is listed by host git (`git remote`) for that git dir and
#         every URL git resolves it to is remote (REMOTE NAMES) and no entry of that name
#         exists in the base (a remote-tracking ref such as origin/main), and a word
#         naming the worktree root itself (from the layout, not core.worktree; e.g.
#         safe.directory; git never runs a directory; one that reaches it through `..` is
#         still walked for `..` IN GIT PATHS).
#         The values of include.path / includeIf.*.path / core.worktree are handled as
#         described above instead.
#     Words with `/` that do not exist and whose top-level directory does not exist either
#     REFUSE (e.g. `alias.x = !git log upstream/main` without an `upstream` remote): false
#     refusals are accepted.
#     Includes deeper than 10 (loops) or more than 1000 config files per repo, unparsable
#     configs, `~user/` paths and targets in the rw state dirs refuse.
#   - `..` IN GIT PATHS: every path pa-sandbox walks for the above (git dirs, commondirs,
#     config / include files, config words, core.hooksPath, core.worktree (host git chdirs
#     into it and opens submodule .git files below it; also through a symlink inside the
#     workspace refuses), absolute url.<base>.insteadOf / pushInsteadOf bases, the targets of
#     symlinked git control files) is checked per hop BEFORE `..` is applied to the text, as for HOME
#     SYMLINKS: a path that enters a directory inside the workspace or an rw state path and
#     leaves it again through `..` (core.hooksPath = tools/../hooks, include.path =
#     <ws>/tools/../hooks/inc.cfg, also several `..`) refuses ("<key / file / git dir /
#     link>: '<path>' goes through '<dir>', which the sandbox can write"): inside, that
#     directory could be replaced by a symlink and host git would read what it then names.
#     Every spelling is walked: a config word is skipped as done only when written exactly
#     the same, never because it normalises to a path already protected (`tools/../hooks/x`
#     after `hooks/x`, in any git dir). Checked once every
#     protection is known: exempt is a directory inside an existing protected (ro) path
#     (`../x` relative to .git/config, a submodule's core.worktree = ../../../sub) or inside
#     a top-level workspace directory that ANCESTORS ro-binds (that of ANY protected path,
#     gitfile or missing reference: sub/x/../hooks, a submodule gitfile sub/.git ->
#     ../.git/modules/sub, a nested repo's commondir ../../../shared/c). The workspace root
#     and an rw state dir themselves are mount points and never count; as for HOME SYMLINKS,
#     both are recognised by their canonical names only.
#   - SYMLINKED GIT CONTROL FILES refuse: every symlink inside each git dir and common dir
#     (hooks/ and its entries, config, config.worktree, commondir, gitdir, info/*,
#     worktrees/*/gitdir|commondir, ...: the whole dir is scanned) and inside each
#     core.hooksPath directory is resolved; one that resolves into the workspace or an rw
#     state dir (or goes through a writable symlink) refuses, one pointing elsewhere is
#     followed (directories are scanned too, 4 levels). Config / include files are walked
#     the same way: a symlink outside the workspace that leads into it refuses. Any find
#     error refuses.
#   - HARD LINKS refuse: a regular file with more than one link in those same scanned dirs
#     (git dirs, common dirs, hooksPath dirs, symlinked-dir targets), a config / include
#     file, a file a symlink there resolves to, or an existing file named by a config value
#     is looked up (device+inode) among the multi-link files of the workspace and the rw
#     state paths; a match outside every ro bind (it could be rewritten through that name,
#     e.g. `ln scripts/pre-commit .git/hooks/pre-commit`) refuses. Any find error refuses.
#     Other names outside the workspace/state are not writable inside and are accepted.
#   - HOME SYMLINKS / BIND MOUNTS: files the host later reads or runs through the user's
#     HOME (~/.config/nvim -> <ws>/nvim, a systemd user unit link, a container bind mount of
#     <ws>/gitconfig on ~/.gitconfig) are read-only inside, or pa-sandbox refuses to start when
#     they cannot be protected (below).
#     At launch every symlink under each home -- $HOME and, if different, the passwd home
#     (getent) -- is listed with `find -H <home>/ -maxdepth PA_SANDBOX_HOME_DEPTH` (6; not
#     descending into .git, node_modules, ~/.cache, ~/go/src, ~/go/pkg or the workspace),
#     plus the same scan of $XDG_CONFIG_HOME, $XDG_DATA_HOME, $ZDOTDIR, of ~/.config,
#     ~/.config/systemd/user, ~/.local/share, ~/.local/bin, ~/.ssh and ~/.gnupg when they
#     are symlinks themselves, and of every $PATH entry under a home. Each link is
#     resolved hop by hop (also through symlinks outside the workspace); every symlink
#     inside the workspace on the way and the final target, when inside the workspace, is
#     protected: an existing target is ro-bound (a directory as a whole); a symlink on the
#     way or a missing target is covered by its ro top-level ancestor (ANCESTORS) and
#     refuses when it sits directly under the root; a link to the workspace root itself or
#     into an rw state path refuses. Each path component is checked per hop BEFORE `..` is
#     applied to the text: a link whose path enters a real directory inside the workspace
#     or an rw state path and leaves it again through `..` (~/.toolrc -> <ws>/sub/../../x,
#     also several `..` or a later link in the chain) refuses ("goes through '<dir>', which
#     the sandbox can write"): inside, that directory could be replaced by a symlink and the
#     host would read what it then names. Exempt is a directory inside a protected (ro)
#     path or inside the top-level directory ro-bound for that same link (that of its
#     workspace target or of a workspace symlink on its way). A link pa-sandbox cannot
#     resolve (a newline in its path or a link target, more than 40 links / a loop, a link
#     that cannot be read) refuses as well. A bind mount below a home (/proc/self/mountinfo) is
#     mapped to where its source is visible (another mount of the same filesystem: target
#     + root difference) and handled the same way. The count and up to 5 examples go to
#     stderr every run. More than PA_SANDBOX_MAX_HOME_LINKS (20000) symlinks REFUSES (the
#     scan would be cut short; raise it to accept). Unreadable directories are skipped
#     with a warning instead (this uid cannot read through them either; refusing would
#     make pa-sandbox unusable wherever HOME holds root-owned or container-storage dirs).
#   - ANCESTORS: a mount point cannot be renamed, but its writable parent can (the
#     mount moves along and the original path is free for an attacker-made git dir
#     that the unchanged gitfile / a later host git run trusts). So for every protected
#     git path below the workspace root, its TOP-LEVEL ancestor directory (the entry
#     directly under the root) is ro-bound as well (a mount point itself, read-only
#     inside). Paths are canonical; a non-directory/symlink/missing ancestor refuses.
#     A workspace without a `.git` is refused (an agent
#     could plant one that a later unsandboxed git run would trust), override:
#     PA_SANDBOX_ALLOW_NO_GIT=1 (UNSAFE).
#   - KERNEL VENV INTERPRETER: kernel-venv/bin/python and the pyvenv.cfg `home` are walked
#     component by component; for every symlink on the way that the sandbox would hide
#     (under $HOME or /tmp, outside the agent dir) the directory holding it is ro-bound
#     (uv: ~/.local/share/uv/python, which holds cpython-3.11-linux-x86_64-gnu ->
#     cpython-3.11.17-linux-x86_64-gnu), or the link itself (bwrap mounts its target at the
#     link's path) when that directory is $HOME or holds the workspace or the agent dir; the
#     resolved install (the interpreter's ../..) is ro-bound too. A way through the
#     workspace or an rw state path (a symlink there, the interpreter or `home` inside, a
#     `..` leaving such a directory) refuses: the sandbox could re-point it.
#   - The workspace may not be /, $HOME, any ancestor of $HOME or of ~/.prime/agent,
#     or inside ~/.prime/agent (realpath comparison).
#   - /run/user and /run/dbus are emptied; PA_SANDBOX_MASK_PATHS (default
#     /run/docker.sock /run/podman/podman.sock) are masked.
#   - Environment is cleared to an allowlist: PATH TERM COLORTERM LANG LC_* TZ USER
#     LOGNAME, PRIME_AGENT_*, the provider key names from models.json
#     (OLLAMA_API_KEY VLLM_API_KEY), plus PA_SANDBOX_PASS_ENV (space-separated).
#     TMPDIR named there is passed as /tmp (the sandbox's own tmpfs), never the caller's
#     value: pa-sandbox points its own TMPDIR at its PRIVATE TEMP DIR, which does not exist
#     inside, and a caller's dir outside the workspace is not there either; a caller's
#     TMPDIR other than /tmp is reported (warning) and not passed.
#   - Own daemon socket (/tmp/pa-sandbox/daemon.sock on a private tmpfs).
#   - PRIME_AGENT_BASH_COMMAND_PREFIX sources the shell guard; before exec the guard
#     is proven INSIDE the sandbox (harmless command runs, a blocked one gets rc 126)
#     else fail closed (UNSAFE override: PA_SANDBOX_ALLOW_NO_GUARD=1, warns every run).
#   - --unshare-pid + private /proc; if the host refuses that mount, falling back to
#     the host /proc is opt-in (PA_SANDBOX_ALLOW_HOST_PROC=1) and warns every run.
#     The fallback has NO PID namespace (inside a pid ns the host /proc shows the
#     wrong /proc/$$, which makes the guard fail closed). So survivors are swept
#     instead, with an identity taken ON THE HOST: bwrap runs with --info-fd and
#     --block-fd; a host-side watcher reads the sandbox child's /proc/<pid>/ns/ipc
#     and ns/user while the child is held blocked, and pa-sandbox keeps that pair in
#     its own files (never bound into the sandbox: nothing the sandbox writes can
#     choose what gets swept). After the command exits (once; also on INT/TERM) every
#     process whose ipc namespace equals the recorded one AND whose user namespace is
#     the recorded one or nested inside it (kernel ancestry) is SIGKILLed and
#     waited for (5 s bound, then rc 70, loudly) BEFORE the final state scrub. The
#     pair is never used if either id equals pa-sandbox's own. A namespace id cannot
#     be reused while any member process is alive (members hold the ns), so matching
#     live members is safe; a bwrap user ns is unique to its sandbox, so other
#     sandboxes, containers and host processes cannot match.
#   - --unshare-user --disable-userns --assert-userns-disabled: no nested user
#     namespaces inside (otherwise `unshare -U --ipc` leaves the swept namespace).
#
# KNOWN LIMITS
#   - Network stays ON (model APIs need it): there is NO egress allowlist, so
#     anything readable inside (the workspace, ~/.prime/agent/auth.json) can be
#     exfiltrated.
#   - The workspace is rw: a prompt-injected agent can modify its files, including
#     creating project-local prime-agent config (<repo>/.prime/agent/settings.json,
#     AGENTS.md, .agents/skills ...) that a later UNSANDBOXED run in that repo would
#     load. Review untracked files (git status) after a sandboxed run. Not blocked.
#   - rw state dirs could get planted symlinks/FIFOs that a later UNSANDBOXED daemon
#     follows; they are scrubbed (non-regular, non-directory entries deleted) at
#     launch and after the sandboxed process exits (also on INT/TERM; not on
#     SIGKILL of pa-sandbox itself -- the next launch scrubs). Not a defence
#     against races while the sandboxed process is still running.
#   - If pa-sandbox itself is SIGKILLed, leftover sandbox processes are NOT swept: the
#     sandbox identity only exists in the dead run's memory and nothing is guessed. The
#     next launch scrubs state dirs, but a survivor could re-plant afterwards.
#   - A symlinked nested `.git` makes pa-sandbox refuse to start (override, UNSAFE:
#     PA_SANDBOX_ALLOW_GIT_SYMLINKS=1); any error while scanning for nested `.git`
#     (unreadable dir) also refuses.
#   - TRADE-OFF: every top-level workspace directory that contains a protected git
#     path (nested `.git`, a gitfile's gitdir, an in-workspace common dir, a config
#     reference such as .husky/_ or tools/fsmon.sh), e.g. vendor/ holding
#     vendor/dep/.git, is ENTIRELY read-only inside the sandbox, and so is a config
#     reference directly under the root (.githooks, .gitconfig); all are listed on
#     stderr every run. A `.git` directly under the root needs no extra bind.
#   - CONFIG REFERENCES are protected by value shape (plus the _nonpath key exclusions for
#     one-word values): what is NOT followed is
#     (a) a missing word without `/` in a value of TWO OR MORE words that is not in an
#     interpreter/wrapper position: the first word of a command (`hx`, `gh auth ...`) is
#     looked up in the host PATH, outside the workspace unless PATH itself has a relative,
#     empty or workspace entry; any other word (`lumen diff`, `log HEAD`, a person's name,
#     `ssh -F sshconf`, `ssh -Fsshconf`, `ssh -i key`) is an argument of a program not on
#     the ireg/wreg lists: such a program that opens or runs it relative to the current
#     directory (`just x`, `npm run x`, ssh's -F/-i, a workspace script that sources "$1")
#     is not covered while the file is MISSING -- the lists are fixed names -- and neither
#     is a missing path value that contains spaces (remotes.<group> values are not
#     in (a): their words are REMOTE NAMES, resolved and protected). A missing ONE-word value of a _nonpath
#     key is not followed because git never opens it relative to the current directory:
#     a COMMAND key's value goes to the shell or execvp, which look a name without `/` up
#     in PATH (same PATH caveat as above), alias.* runs `git <value>`, credential.helper
#     `git credential-<value>`, remote.*.vcs `git remote-<value>`, *.tool / *.guitool /
#     web.browser / merge.<driver>.recursive / pull.twohead|octopus name a tool, driver or
#     merge strategy that git maps to its own config or to git-<name> on exec-path/PATH;
#     names, e-mails and descriptions (user.*, author.*, committer.*, *.name, *.username,
#     branch.*.description) are only printed or sent; enums, booleans, numbers, dates,
#     colors, formats and patterns (color.*, column.*, push.*, pull.*, merge.*, rebase.*,
#     log.*, status.*, gc.* except gc.repackFilterTo, protocol.*, extensions.* except
#     partialClone, core.autocrlf, ...) are parsed as keywords; refs, branch names and
#     refspecs (branch.*.merge, init.defaultBranch, submodule.*.branch, remote.*.fetch|push)
#     name refs inside the ro git dir (or on the remote), never workspace files; url.*
#     values are URL prefixes compared as text. (b) files a
#     protected script or program reads INDIRECTLY (a hook that sources ./lib.sh, a
#     Makefile it runs, package.json), including an interpreter's MODULE SEARCH PATH:
#     `python3 -m mod` / `python3 x.py` put the current / script directory first on
#     sys.path, so with an existing `mod` only that entry is ro and a planted mod.py or
#     json.py in the writable root still runs; node resolves ./node_modules the same way
#     (a missing `mod` at the root refuses, see above); (c) a
#     relative path git resolves against the CURRENT directory of the host git call (e.g.
#     core.pager run from a subdirectory) rather than a worktree root; (d) host-side
#     config that pa-sandbox never sees: GIT_CONFIG_COUNT/KEY_*/VALUE_*,
#     GIT_CONFIG_PARAMETERS, `git -c`, GIT_DIR/GIT_WORK_TREE and other env of the later
#     host git run -- REMOTE NAMES are resolved with pa-sandbox's own environment AT
#     LAUNCH, so a later host git run whose env, global config or includeIf condition
#     (onbranch:, hasconfig:) differs may resolve a remote name to a different URL;
#     (e) words removed by the exclusion rules above (a refspec-looking,
#     `host:path` or `origin/...` word that really is a script path). In-tree
#     .gitattributes / .gitignore stay writable (they only select drivers defined in
#     the ro config), .gitmodules is a worktree file (git ignores `update = !cmd` from
#     it), objects/info/alternates targets are object data.
#   - FILE URLS WITH A HOST: a `file://<host>/<path>` URL whose host is not empty or
#     `localhost` (also `file://~/...`) is treated as remote and NOT checked -- in a remote
#     url, an insteadOf / pushInsteadOf base or a config word. Host git (2.54) ignores the
#     host part and opens <path> locally, so such a URL naming a workspace path lets a
#     later host `git push` / `git fetch` run hooks or read objects the sandbox planted
#     there. Do not use file:// URLs with a host part for workspace paths.
#   - GIT REPOS THAT DID NOT EXIST AT LAUNCH are attacker controlled (a new `.git`, a new
#     bare repo, a new `.git` in an uninitialised submodule directory): host git runs their
#     hooks/config when it uses them -- run inside them (git -C there), through a repo
#     OUTSIDE the workspace that names a path in it (remote url pushed/fetched to,
#     alternates, a submodule url; outside repos' configs are never scanned), and through
#     SUBMODULE RECURSION from the parent: `git status` at the root recurses into a
#     registered submodule whose `.git` the sandbox created and runs e.g. its
#     core.fsmonitor (an unregistered nested repo is only an untracked dir and is not
#     entered). After a sandboxed run, look for new `.git` entries / bare repos before
#     running host git, or use `--ignore-submodules=all`. The same holds for a remote
#     name typed on a later host command line (`git push foo`) that no source listed
#     under REMOTE NAMES knew at launch: git uses ./foo as a path the human chose. A
#     remote GROUP name that host git expands (2+ members) is not protected as a path,
#     but `git push <group>` does not expand groups (git 2.54) and uses ./<group> like
#     such a typed name (`git pull <group>` expands it, through fetch); so does a group
#     whose members host git counts differently later (includeIf onbranch:, env -- (d)).
#   - HOME SYMLINKS cover what the scan sees AT LAUNCH only: symlinks deeper than
#     PA_SANDBOX_HOME_DEPTH, under the pruned dirs (~/.cache, ~/go/src, ~/go/pkg, .git,
#     node_modules), inside a symlinked directory that is not one of the listed roots, or
#     created after launch are not followed. Neither are other ways the host reaches a
#     workspace file: a HARD LINK in HOME to it, a workspace path written in a non-shell
#     config (an editor, tmux or systemd file naming a workspace script: each tool has its
#     own language and pa-sandbox only parses git config), files
#     such a protected file reads INDIRECTLY (as CONFIG REFERENCES (b)), and a bind mount
#     whose source is not visible anywhere in pa-sandbox's mount namespace. The workspace and
#     the rw state paths are recognised by their canonical names only: a link that reaches
#     them through ANOTHER name (a bind mount of the workspace or of a directory above it
#     elsewhere) is treated as pointing outside -- neither made read-only nor refused.
#   - SHELL STARTUP FILES ARE NOT CHECKED: pa-sandbox does not check whether a host shell's
#     startup files (~/.zshrc, ~/.bashrc, $ZDOTDIR, fish / readline / completion files ...) or
#     its launch environment (PATH, fpath, BASH_ENV, ENV, ZDOTDIR, XDG_*, LD_* ...) make a
#     later host shell read or run files inside the workspace (source, autoload, fpath, PATH,
#     globs ...): it does not read or parse them. If the host's rc loads a workspace file that
#     the sandbox modified, code from inside the sandbox can run on the host. Avoiding that is
#     up to the user: do not load workspace paths from your rc. (A startup file that is itself
#     a HOME symlink into the workspace is handled like any HOME SYMLINKS target -- read-only
#     inside, or refused when it cannot be protected; the files it loads are not.) This is a
#     guardrail, not a security boundary.
#   - SUBMODULE / WORKTREE ROOTS are only bases for the config words: the root directory
#     itself is not made read-only (a missing root is not refused unless a config word
#     relative to it is), and a `.git` gitfile the sandbox creates there is a new `.git`
#     (above). The root is derived from the state at launch; .gitmodules is a writable
#     worktree file, so a later host `git submodule update` may map a module name to a
#     different gitlink path than the one protected (core.worktree, when set, is used as
#     well). Other directories inside a scanned git dir are not searched for git dirs
#     (git keeps submodule and worktree git dirs in `modules/` and `worktrees/`; a git dir
#     another tool keeps elsewhere inside .git is not covered).
#   - FALSE REFUSALS are accepted: a config word with `/` that is no path (`textconv = sed
#     s/a/b/`, `!git log upstream/main` without that remote), a missing path whose
#     top-level directory is missing too, or a symlinked hook/config into the workspace
#     makes pa-sandbox refuse; so does any missing word in an interpreter/wrapper position
#     that is no file (`sh -c "make lint"`, `timeout -s KILL 5 sh x`, `go run ./cmd`'s
#     `run`, `sh "$1"`), a missing ONE-word value of a key not in _nonpath (an enum of a
#     tool's own key, `tool.x.mode = fast`), a remote group of 0 or 1 member, or a member
#     that is neither a remote nor a group of 2+ (when ./<name> is missing directly under
#     the root), a submodule/worktree git dir whose root cannot
#     be told, a hard link described above, and a HOME link that leaves a writable workspace
#     directory through `..` (HOME SYMLINKS) even when nothing would replace it (~/.x ->
#     <ws>/sub/../free/f, with sub and free different top-level dirs) -- also when sub/ is
#     read-only only because of ANOTHER reference (for HOME links only the link's own target
#     and the workspace symlinks on its way count); likewise a git path that leaves a writable
#     workspace directory through `..` (`..` IN GIT PATHS) even when nothing would replace it
#     (a gitfile `gitdir: ../../src/../store/gd` with an unprotected src/, an insteadOf
#     base <ws>/sub/../../mirrors/ that names a directory outside the workspace); an empty
#     url.<base> (`[url ""] insteadOf = x:`) or a relative one, also one that git would
#     never be asked to rewrite; and a HOME
#     symlink loop or a HOME link that vanished during the scan (HOME SYMLINKS); a kernel venv
#     whose interpreter or pyvenv.cfg `home` goes through the workspace or an rw state path
#     (KERNEL VENV INTERPRETER), even when nothing there would be re-pointed. A word that happens to name an
#     existing workspace entry (`core.editor = nvim` with an nvim/ directory at the root)
#     makes that entry read-only (listed on stderr).
#   - settings.json, mcp-service-catalog.v2.json and models/ are ro: the sandboxed daemon's
#     settings writes (e.g. the onboarding answer: "could not be saved") and catalog
#     refreshes fail; the host keeps its copies.
#   - auth.json is ro: a token refreshed inside the sandbox cannot be saved (the daemon
#     keeps it in memory at most). If the provider ROTATES refresh tokens, a refresh inside
#     can invalidate the refresh token the host still holds (log in again on the host).
#     Untested against a real OAuth provider. A login inside the sandbox when the host has
#     no auth.json lands in the private tmpfs and is discarded.
#   - NEW NAMES in the agent dir root are writable INSIDE (the private tmpfs): a SYSTEM.md,
#     extensions/, mcp.json ... that the host lacks can be created there, and the sandboxed
#     prime-agent may load it for the rest of that run (no more than code running inside
#     can do anyway; the workspace's project-local config is writable too). The host never
#     sees them. The agent dir is LISTED ONCE, when pa-sandbox builds the profile, not when
#     the sandbox starts: a host entry created after that is not visible inside, and one
#     removed after that (the host daemon's short-lived locks and temp files) is absent
#     inside, so its name is a NEW NAME too -- what the sandbox creates under it stays in the
#     tmpfs, and the host's own entry of that name, if recreated, is unaffected.
#     LOCK NAMES (*.lock, *.lock.*: settings.json.lock/, auth.json.lock/,
#     kernel-venv.bootstrap.lock, its .candidate-* files) are always NEW NAMES, also when the
#     host has them: bound read-only, a lock the host held at listing time stays held inside
#     for the whole run (the mount outlives the host's rmdir); measured with prime-agent
#     0.10.0 and host settings.json.lock/ + auth.json.lock/ bound: a daemon session's turn
#     failed ("The daemon model allowlist could not be read (Read-only file system (os
#     error 30))"), and a `-p` settings write waited ~4 s, then "Failed to acquire settings
#     lock: Lock file is already being held". Unbound, the
#     sandboxed daemon takes a private lock, so it does not exclude the host's daemon: what
#     those locks guard (settings.json, auth.json, kernel-venv/) is bound read-only, and the
#     sandbox reads the copy bound at start (a host atomic rename-over is not seen inside).
#   - daemon-workers/ and rlm-ledger/ are sandbox-private and discarded at exit: a session
#     continued later on the host has no ledger records of spawns made inside.
#   - rw state dirs are writable by design (sessions, session-artifacts, session-leases,
#     logs, swarm); they persist on the host as before.
#   - Git write operations inside fail by design (see above); linked-worktree
#     gitfile targets must already be valid common dirs.
#   - Requires the installed layout: `make primeagent/install` must have put
#     ~/.prime/agent/bin/prime-shell-guard.sh in place; without it pa-sandbox fails
#     closed (agent/harnesses/primeagent/install.sh links it).
#   - With the host /proc fallback, same-uid /proc/<pid>/environ is readable.
#   - Host files outside $HOME are readable (ro); other unix sockets under /run
#     stay connectable (connect() works on ro mounts).
#   - With a tty, TIOCSTI protection depends on the host kernel (off since 6.2).
#
# Usage: pa-sandbox [prime-agent args...]
# Test hook: source this file; call pa_sandbox_build_argv <workspace>; then run
# "${PA_BWRAP_ARGV[@]}" <command...>.
set -euo pipefail

# Pure session/runtime state only. harness/ (global cross-session harness memory)
# and cron-jobs.json (scheduled prompts run by the host daemon) are deliberately
# NOT here: later unsandboxed sessions trust them, so sandboxed runs cannot
# persist harness memory or schedules.
# Also NOT rw: mcp-service-catalog.v2.json (MCP service definitions incl. stdio
# commands that unsandboxed runs trust; the sandboxed daemon's refresh fails and is
# logged), models/ (provider catalog cache) and kernel-venv/ (code the host runs).
PA_SANDBOX_AGENT_RW_DIRS=(sessions session-artifacts session-leases logs swarm)
PA_SANDBOX_AGENT_RW_FILES=(telemetry.json telemetry.jsonl)
# SANDBOX-PRIVATE (disposable) dirs: an empty tmpfs inside, so the sandboxed daemon can
# write there, but nothing reaches the host and it is gone when the sandbox exits; the
# host's own entries there are hidden inside. daemon-workers/ (supervisor-config and
# per-worker state of the sandbox's daemon, keyed by its socket) and rlm-ledger/
# (rlm.spawn / factory spawn ledger) are the daemon's own writes below the agent dir
# (measured, prime-agent 0.10.0) outside the rw state dirs; listed here so that a host
# copy (a host daemon's daemon-workers/<socket hash>/) is hidden rather than read-only.
PA_SANDBOX_AGENT_TMP_DIRS=(daemon-workers rlm-ledger)
: "${PA_SANDBOX_MAX_NESTED_GIT:=500}"
: "${PA_SANDBOX_MAX_HOME_LINKS:=20000}"
: "${PA_SANDBOX_HOME_DEPTH:=6}"
: "${PA_SANDBOX_SETUP_TRIES:=3}"
# shellcheck disable=SC2016  # guard prefix is intentionally unexpanded (the kernel expands $HOME)
PA_SANDBOX_GUARD_PREFIX='. "$HOME/.prime/agent/bin/prime-shell-guard.sh"'
PA_SANDBOX_ENV_ALLOW=(PATH TERM COLORTERM LANG TZ USER LOGNAME OLLAMA_API_KEY VLLM_API_KEY)

pa_sandbox_die() {
	printf 'pa-sandbox: %s\n' "$1" >&2
	return "${2:-1}"
}

pa_sandbox_warn() { printf 'pa-sandbox: warning: %s\n' "$1" >&2; }

pa_sandbox_require_bwrap() {
	command -v bwrap >/dev/null 2>&1 || {
		pa_sandbox_die "bwrap (bubblewrap) not found in PATH; refusing to run unsandboxed (install: pacman -S bubblewrap)" 127
		return 127
	}
}

pa_sandbox_repo_root() { # <dir> -> repo root (git toplevel or the dir itself)
	local top
	top="$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)" || top="$1"
	printf '%s\n' "$top"
}

# <path> is <base> or inside <base> (both canonical absolute paths)
pa_sandbox_within() { [[ "$1" == "$2" || "$1" == "$2"/* ]]; }

# Validate a git common dir that lives outside the workspace; echo it if OK.
pa_sandbox_valid_gcd() { # <repo> <home> <agent_dir>
	local gcd
	gcd="$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
	[[ "$gcd" == /* && -d "$gcd" ]] || return 1
	gcd="$(cd -P "$gcd" && pwd)" || return 1
	[[ -f "$gcd/HEAD" && -d "$gcd/objects" ]] || return 1
	pa_sandbox_within "$gcd" "$2/.prime" && return 1
	pa_sandbox_within "$2" "$gcd" && return 1  # gcd is $HOME or an ancestor of it
	pa_sandbox_within "$3" "$gcd" && return 1  # ... or an ancestor of the agent dir
	printf '%s\n' "$gcd"
}

# pa_sandbox_build_argv <workspace>: fills global array PA_BWRAP_ARGV (ends with "--").
pa_sandbox_build_argv() {
	local repo home agent_dir name extra
	repo="$(cd -P "$1" && pwd)" || return 1
	home="${HOME:?HOME unset}"
	home="$(cd -P "$home" && pwd)" || return 1
	agent_dir="$home/.prime/agent"
	mkdir -p "$agent_dir"
	agent_dir="$(cd -P "$agent_dir" && pwd)"

	if [[ "$repo" == "/" ]] || pa_sandbox_within "$home" "$repo" || pa_sandbox_within "$agent_dir" "$repo" \
		|| pa_sandbox_within "$repo" "$agent_dir"; then
		pa_sandbox_die "refusing '$repo' as the workspace (it is / , \$HOME, an ancestor of \$HOME or ~/.prime/agent, or inside ~/.prime/agent); run from inside a project directory"
		return 1
	fi
	if [[ "${PA_SANDBOX_ALLOW_NO_GUARD:-0}" != 1 && ! -f "$agent_dir/bin/prime-shell-guard.sh" ]]; then
		pa_sandbox_die "$agent_dir/bin/prime-shell-guard.sh not found (run the installer); UNSAFE override: PA_SANDBOX_ALLOW_NO_GUARD=1"
		return 1
	fi

	# A `.git` FILE (linked worktree) points outside the workspace; its common dir is
	# validated strictly and bound read-only. A plain `.git` dir is bound ro as is.
	local gcd="" tgd=""
	if [[ ! -e "$repo/.git" && "${PA_SANDBOX_ALLOW_NO_GIT:-0}" != 1 ]]; then
		pa_sandbox_die "workspace '$repo' has no .git (an agent could plant one that a later host git run trusts); UNSAFE override: PA_SANDBOX_ALLOW_NO_GIT=1"
		return 1
	fi
	if [[ -f "$repo/.git" ]]; then
		if ! gcd="$(pa_sandbox_valid_gcd "$repo" "$home" "$agent_dir")"; then
			pa_sandbox_die "workspace .git points to a git dir that is not a valid, safe common dir; refusing"
			return 1
		fi
		# its gitdir (tgd) is protected like every other git dir below (_git_ctx)
		local tl
		tl="$(head -n1 "$repo/.git")"
		if [[ "$tl" != "gitdir: "* ]]; then
			pa_sandbox_die "workspace .git gitfile has an unexpected format; refusing"
			return 1
		fi
		tgd="${tl#gitdir: }"
		[[ "$tgd" == /* ]] || tgd="$repo/$tgd"
	fi

	# State dirs must exist on the host before binding (nothing new may appear later).
	for name in "${PA_SANDBOX_AGENT_RW_DIRS[@]}"; do
		[[ -L "$agent_dir/$name" ]] && {
			pa_sandbox_die "$agent_dir/$name is a symlink; refusing to bind it rw"
			return 1
		}
		mkdir -p "$agent_dir/$name"
	done

	PA_BWRAP_ARGV=(
		bwrap
		--ro-bind / /
		--dev /dev
		--tmpfs /tmp
		--tmpfs "$home"
		--unshare-user --disable-userns --assert-userns-disabled
		--unshare-ipc --unshare-uts
		--die-with-parent
	)
	# Private PID namespace + fresh /proc hides other processes' environ. Falling
	# back to the host /proc leaks same-uid environments, so it is explicit opt-in.
	if bwrap --ro-bind / / --unshare-pid --proc /proc true 2>/dev/null; then
		PA_BWRAP_ARGV+=(--unshare-pid --proc /proc)
	elif [[ "${PA_SANDBOX_ALLOW_HOST_PROC:-0}" == 1 ]]; then
		pa_sandbox_warn "private /proc unavailable; using host /proc (same-uid process environments are readable)"
		PA_BWRAP_ARGV+=(--proc /proc)
	else
		pa_sandbox_die "cannot mount a private /proc (--unshare-pid) on this host; set PA_SANDBOX_ALLOW_HOST_PROC=1 to accept host /proc exposure"
		return 1
	fi
	for extra in /run/user /run/dbus; do
		[[ -d "$extra" ]] && PA_BWRAP_ARGV+=(--tmpfs "$extra")
	done
	local -a masks=()
	read -ra masks <<<"${PA_SANDBOX_MASK_PATHS:-/run/docker.sock /run/podman/podman.sock}"
	for extra in "${masks[@]}"; do
		[[ -S "$extra" ]] && PA_BWRAP_ARGV+=(--ro-bind /dev/null "$extra")
	done
	[[ -t 0 ]] || PA_BWRAP_ARGV+=(--new-session)

	# 1) agent dir: a sandbox-private tmpfs at its path in which every host entry LISTED HERE
	#    is bound read-only at its own path (a mount point cannot be written, removed, renamed
	#    or replaced from inside). Only names that are not bound (not listed, vanished before
	#    bwrap ran, or a lock name below) can be created, in that tmpfs: they never reach the
	#    host and vanish with the sandbox.
	#    --ro-bind-try: the list is used by every later bwrap run of this profile (the guard
	#    probes and the real run, ~1 s later); a host entry removed meanwhile (the host daemon's
	#    short-lived locks and temp files) is skipped instead of aborting bwrap ("Can't find
	#    source path") and is then a tmpfs-only name like any name the host lacks. (bwrap
	#    checks a -try source and mounts it a moment later; a removal in between still fails
	#    the setup: pa_sandbox_main retries that.)
	#    LOCK NAMES (*.lock, *.lock.*: prime-agent's mkdir locks settings.json.lock/ and
	#    auth.json.lock/, taken even to read settings, and kernel-venv.bootstrap.lock with its
	#    .candidate-* files) are never bound: a bound one is the host's lock frozen for the whole
	#    run (the mount outlives the host's rmdir), and the sandboxed daemon fails closed
	#    ("The daemon model allowlist could not be read", measured; NEW NAMES). Unbound, it
	#    takes a private lock in the tmpfs; what the locks guard is bound read-only either way.
	PA_BWRAP_ARGV+=(--tmpfs "$agent_dir")
	local -A aown=() # entries bound below instead (rw state, sandbox-private tmpfs)
	local alist aerr arc=0
	for name in "${PA_SANDBOX_AGENT_RW_DIRS[@]}" "${PA_SANDBOX_AGENT_TMP_DIRS[@]}"; do aown[$name]=1; done
	for name in "${PA_SANDBOX_AGENT_RW_FILES[@]}"; do
		[[ -f "$agent_dir/$name" && ! -L "$agent_dir/$name" ]] && aown[$name]=1
	done
	alist="$(mktemp)"
	aerr="$(mktemp)"
	# names only (readdir, no stat): an entry the host removes while it is listed is no error
	# (it is skipped or bound with --ro-bind-try below); any listing error still refuses.
	# Not find: GNU find 4.10 -ignore_readdir_race still reports ENOENT for a directory
	# removed right after readdir (measured, 9 of 1500 listings under churn)
	python3 -I -c 'import os, sys
sys.stdout.buffer.write(b"".join(n + b"\0" for n in os.listdir(os.fsencode(sys.argv[1]))))' "$agent_dir" >"$alist" 2>"$aerr" || arc=$?
	if [[ $arc -ne 0 || -s "$aerr" ]]; then
		pa_sandbox_die "cannot list $agent_dir (rc=$arc): $(head -c 400 "$aerr"); refusing"
		command rm -f "$alist" "$aerr"
		return 1
	fi
	command rm -f "$aerr"
	while IFS= read -r -d '' name; do
		[[ -n "${aown[$name]:-}" ]] && continue
		[[ "$name" == *.lock || "$name" == *.lock.* ]] && continue
		# a dangling symlink is absent inside, as it is for the host
		[[ -e "$agent_dir/$name" ]] && PA_BWRAP_ARGV+=(--ro-bind-try "$agent_dir/$name" "$agent_dir/$name")
	done <"$alist"
	command rm -f "$alist"
	# 2) all rw binds (state allowlist, workspace, validated common dir)
	for name in "${PA_SANDBOX_AGENT_RW_DIRS[@]}"; do
		PA_BWRAP_ARGV+=(--bind "$agent_dir/$name" "$agent_dir/$name")
	done
	for name in "${PA_SANDBOX_AGENT_RW_FILES[@]}"; do
		[[ -f "$agent_dir/$name" && ! -L "$agent_dir/$name" ]] && PA_BWRAP_ARGV+=(--bind "$agent_dir/$name" "$agent_dir/$name")
	done
	for name in "${PA_SANDBOX_AGENT_TMP_DIRS[@]}"; do
		PA_BWRAP_ARGV+=(--tmpfs "$agent_dir/$name")
	done
	PA_BWRAP_ARGV+=(--bind "$repo" "$repo")

	# 3) all ro (re)binds LAST
	local -A seen=()
	_ro() { # <path>: ro-bind once, only if it exists
		[[ -e "$1" && -z "${seen[$1]:-}" ]] || return 0
		seen[$1]=1
		PA_BWRAP_ARGV+=(--ro-bind "$1" "$1")
	}
	_ro "$home/.local/bin"
	_ro "$home/.local/share/prime-agent"
	# (the kernel venv's interpreter is exposed below, once _walk and _rw exist)
	# Guard + its dependencies: the guard checkout's agent/ tree, same path.
	local guard groot="" tgt
	if guard="$(readlink -f "$agent_dir/bin/prime-shell-guard.sh" 2>/dev/null)" && [[ -f "$guard" ]]; then
		groot="$(cd -P "$(dirname "$guard")/../.." 2>/dev/null && pwd)" || groot=""
		[[ -n "$groot" && -d "$groot/agent" ]] && _ro "$groot/agent"
	fi
	# Symlinked agent-dir entries: their real targets must resolve inside (ro).
	while IFS= read -r -d '' name; do
		tgt="$(readlink -f "$name" 2>/dev/null)" || continue
		pa_sandbox_within "$tgt" "$agent_dir" && continue
		[[ -n "$groot" ]] && pa_sandbox_within "$tgt" "$groot/agent" && continue
		_ro "$tgt"
	done < <(find "$agent_dir" -maxdepth 1 -mindepth 1 -type l -print0)
	if [[ -n "${PA_SANDBOX_RO_EXTRA:-}" ]]; then
		local -a ex=()
		IFS=: read -ra ex <<<"$PA_SANDBOX_RO_EXTRA"
		for extra in "${ex[@]}"; do _ro "$extra"; done
	fi
	# git write-back (hooks, config, fsmonitor, commondir/gitfile redirects, rename and
	# re-create of .git) is closed by binding the .git PATH ITSELF read-only: a mount
	# point cannot be renamed or replaced. Linked-worktree common dir: ro as a whole.
	_ro "$repo/.git"
	[[ -n "$gcd" ]] && _ro "$gcd"
	# Scan to files (not process substitution) so a find failure is seen: an
	# unreadable directory could hide a nested .git, so ANY find error fails closed.
	local ng nn=0 scan scanerr frc=0 links=() gfiles=() gdirs=() cfgp=() bares=() hl=() prot=("$repo/.git")
	[[ -n "$gcd" ]] && prot+=("$gcd")
	scan="$(mktemp)"
	scanerr="$(mktemp)"
	# `.git` entries, and HEAD entries (a bare repo / git dir not named .git, see below)
	find "$repo" \( -name .git -prune -printf 'G%p\0' \) -o \( -name HEAD -printf 'H%p\0' \) >"$scan" 2>"$scanerr" || frc=$?
	if [[ $frc -ne 0 || -s "$scanerr" ]]; then
		pa_sandbox_die "scan for nested .git failed (rc=$frc): $(head -c 600 "$scanerr"); refusing"
		command rm -f "$scan" "$scanerr"
		return 1
	fi
	command rm -f "$scanerr"
	# shellcheck disable=SC2094 # the rm in the cap branch runs right before `return`, not concurrently
	while IFS= read -r -d '' ng; do
		if [[ "$ng" == H* ]]; then
			# git's is_git_directory(): HEAD plus objects/ and refs/, or a commondir. Any
			# of the three next to a HEAD counts (safe side).
			ng="${ng#H}"
			ng="${ng%/*}"
			[[ -e "$ng/objects" || -L "$ng/objects" || -e "$ng/refs" || -L "$ng/refs" || -e "$ng/commondir" || -L "$ng/commondir" ]] || continue
			if [[ "$ng" == "$repo" ]]; then
				pa_sandbox_die "the workspace root itself looks like a git dir (HEAD next to objects/, refs/ or commondir); refusing"
				command rm -f "$scan"
				return 1
			fi
			bares+=("$ng")
			continue
		fi
		ng="${ng#G}"
		if [[ -L "$ng" ]]; then
			links+=("$ng")
			continue
		fi
		[[ "$ng" == "$repo/.git" ]] && continue
		[[ -f "$ng" ]] && gfiles+=("$ng")
		nn=$((nn + 1))
		if [[ $nn -gt $PA_SANDBOX_MAX_NESTED_GIT ]]; then
			pa_sandbox_die "more than $PA_SANDBOX_MAX_NESTED_GIT nested .git entries under '$repo'; refusing (raise PA_SANDBOX_MAX_NESTED_GIT to accept)"
			command rm -f "$scan"
			return 1
		fi
		_ro "$ng"
		[[ -d "$ng" ]] && prot+=("$ng") && gdirs+=("$ng")
	done <"$scan"
	command rm -f "$scan"
	# bare repos / git dirs not named .git (outermost only): protected like a nested .git
	local b2 bd
	local -a bk=()
	for bd in "${bares[@]}"; do
		for b2 in "${bares[@]}"; do
			[[ "$bd" == "$b2"/* ]] && continue 2
		done
		nn=$((nn + 1))
		if [[ $nn -gt $PA_SANDBOX_MAX_NESTED_GIT ]]; then
			pa_sandbox_die "more than $PA_SANDBOX_MAX_NESTED_GIT nested git dirs under '$repo'; refusing (raise PA_SANDBOX_MAX_NESTED_GIT to accept)"
			return 1
		fi
		_ro "$bd"
		prot+=("$bd")
		bk+=("$bd")
	done
	bares=("${bk[@]}")
	# A symlinked .git cannot be bound read-only (bwrap would bind its target, and the
	# link itself, in the rw workspace, could be swapped), so refuse to start.
	if [[ ${#links[@]} -gt 0 && "${PA_SANDBOX_ALLOW_GIT_SYMLINKS:-0}" != 1 ]]; then
		pa_sandbox_die "symlinked .git entries cannot be protected, refusing: ${links[*]} (UNSAFE override: PA_SANDBOX_ALLOW_GIT_SYMLINKS=1)"
		return 1
	fi
	# Every git dir (the workspace's own, its gitfile target tgd, nested .git dirs, nested
	# gitfile targets) and the commondir of each is resolved and made read-only (already
	# under a protected path, or ro-bound if inside the workspace) or the run is refused.
	# Then every path that host git later READS or RUNS because a config of that repo
	# (common config, config.worktree, every include/includeIf file, recursively, plus the
	# host global/system config) names it -- core.hooksPath, includes, scripts named in
	# command values -- is protected the same way (CONFIG REFERENCES in the header).
	local -a rwp=("$repo") gk=() gv=() gdd=() ek=() ev=() ed=() wl=()
	local -A pdone=()
	for name in "${PA_SANDBOX_AGENT_RW_DIRS[@]}" "${PA_SANDBOX_AGENT_RW_FILES[@]}"; do
		rwp+=("$agent_dir/$name")
	done
	_rw() { # <canonical path>: writable from inside the sandbox
		local p
		for p in "${rwp[@]}"; do pa_sandbox_within "$1" "$p" && return 0; done
		return 1
	}
	_hl() { # <path>: remember a regular file with more than one hard link (HARD LINKS)
		local s
		[[ -f "$1" && ! -L "$1" ]] || return 0
		if ! s="$(stat -c '%h %d:%i' -- "$1")"; then
			pa_sandbox_die "cannot stat '$1'; refusing"
			return 1
		fi
		[[ "${s%% *}" -le 1 ]] || hl+=("${s#* }"$'\t'"$1")
	}
	# _walk <abs path>: resolve component by component as the kernel does, BEFORE any
	# normalisation (so `lnk/../x` is seen through lnk); sets wq (the result) and wdot.
	# rc 2 = a symlink inside a writable area (it could be re-pointed later); symlinks
	# elsewhere are followed one level at a time (their target is walked the same way; at
	# most 40); rc 1 = cannot be resolved (every caller refuses). A directory strictly inside
	# a writable area that a `..` leaves again is recorded in wdot (checked per hop, before
	# the `..` is applied to the text); the caller queues each in gdot, checked with _hdot once
	# every protection is known (`..` IN GIT PATHS).
	local wq=""
	local -a wdot=() gdot=() whops=()
	_walk() {
		local cur="" c t n=0 w
		local -a parts=() tp=()
		wq=""
		wdot=()
		whops=() # every symlink followed, as the path it was met at
		[[ "$1" == /* && "$1" != *$'\n'* ]] || return 1
		IFS=/ read -ra parts <<<"$1"
		while [[ ${#parts[@]} -gt 0 ]]; do
			c="${parts[0]}"
			parts=("${parts[@]:1}")
			case "$c" in
			"" | .) continue ;;
			..)
				for w in "${rwp[@]}"; do
					[[ "$cur" == "$w"/* ]] && wdot+=("$cur") && break
				done
				cur="${cur%/*}"
				continue
				;;
			esac
			if [[ -L "$cur/$c" ]]; then
				_rw "$cur/$c" && return 2
				whops+=("$cur/$c")
				n=$((n + 1))
				t="$(readlink -- "$cur/$c")" && [[ $n -le 40 && -n "$t" && "$t" != *$'\n'* ]] || return 1
				[[ "$t" == /* ]] && cur=""
				IFS=/ read -ra tp <<<"$t"
				parts=("${tp[@]}" "${parts[@]}")
				continue
			fi
			cur="$cur/$c"
		done
		wq="${cur:-/}"
	}
	# KERNEL VENV INTERPRETER (see header): the venv's bin/python and the pyvenv.cfg `home`
	# reach the interpreter through symlinks (uv: python/cpython-3.11-linux-x86_64-gnu ->
	# cpython-3.11.17-...) that must resolve inside exactly as on the host.
	_vexpose() { # <dir>: ro-bind it when the sandbox hides it ($HOME, /tmp are tmpfs inside)
		local r
		for r in "$home" /tmp; do
			[[ "$1" == "$r"/* ]] || continue
			# never a directory that holds the workspace or the agent dir (the ro bind, made last,
			# would cover their binds)
			pa_sandbox_within "$repo" "$1" || pa_sandbox_within "$agent_dir" "$1" || _ro "$1"
			return 0
		done
	}
	_vpath() { # <abs path> <label>: sets vq (resolved), "" when it does not resolve
		local rc=0 h d r
		vq=""
		_walk "$1" || rc=$?
		if [[ $rc -eq 2 ]] || { [[ $rc -eq 0 ]] && { _rw "$wq" || [[ ${#wdot[@]} -gt 0 ]]; }; }; then
			pa_sandbox_die "$2 '$1' goes through the sandbox-writable workspace or an rw state path (the sandbox could re-point it); refusing"
			return 1
		fi
		[[ $rc -eq 0 ]] || return 0 # unresolvable: the venv is broken on the host as well
		for h in "${whops[@]}"; do
			d="${h%/*}"
			d="${d:-/}"
			pa_sandbox_within "$d" "$agent_dir" && continue # inside the ro agent dir already
			for r in "$home" /tmp; do
				pa_sandbox_within "$h" "$r" || continue
				if [[ "$d" == "$r"/* ]] && ! pa_sandbox_within "$repo" "$d" && ! pa_sandbox_within "$agent_dir" "$d"; then
					_ro "$d" # the directory holding the link (with the link and its siblings)
				else
					_ro "$h" # $HOME itself (or above the workspace): bwrap mounts the target at the link
				fi
				break
			done
		done
		vq="$wq"
	}
	local vq vh
	_vpath "$agent_dir/kernel-venv/bin/python" "kernel venv interpreter" || return 1
	[[ -n "$vq" && "$vq" != "$agent_dir"/* ]] && _vexpose "$(dirname "$(dirname "$vq")")"
	if [[ -f "$agent_dir/kernel-venv/pyvenv.cfg" ]]; then
		vh="$(sed -n 's/^home[[:space:]]*=[[:space:]]*//; T; s/[[:space:]]*$//; p' "$agent_dir/kernel-venv/pyvenv.cfg" | head -n1)"
		if [[ "$vh" == /* ]]; then
			_vpath "$vh" "kernel venv pyvenv.cfg home" || return 1
			[[ -n "$vq" && "$vq" != "$agent_dir"/* ]] && _vexpose "$(dirname "$vq")"
		fi
	fi
	_hdot() { # <dir> <label> [<path>...]: a writable directory a reference leaves through `..` (wdot,
		# hdot) is fine only when nothing inside can replace it: it lies in an existing ro-bound
		# protected path, or in the top-level workspace directory that ANCESTORS ro-binds for one
		# of <path> (HOME: the link's resolved target or a workspace symlink on its way; git paths:
		# every protected path, gitfile or missing reference). Anything else refuses.
		local d="$1" lab="$2" pp m
		shift 2
		for pp in "${prot[@]}"; do
			[[ -e "$pp" ]] && pa_sandbox_within "$d" "$pp" && return 0
		done
		if [[ "$d" == "$repo"/* ]]; then
			pp="${d#"$repo"/}"
			pp="$repo/${pp%%/*}"
			for m in "$@"; do
				pa_sandbox_within "$m" "$pp" && return 0
			done
		fi
		pa_sandbox_die "$lab goes through '$d', which the sandbox can write (a directory there could be replaced by a symlink; the host would read what it then names); refusing"
		return 1
	}
	# _into_ws <path> <resolved>: a symlink (outside the workspace) led <path> into it
	_into_ws() {
		local n
		n="$(realpath -s -m -- "$1")" || return 0
		pa_sandbox_within "$2" "$repo" && [[ "$n" != "$2" ]]
	}
	_protect_dir() { # <dir> <label>: an existing git dir
		local q pp rc=0
		_walk "$1" || rc=$?
		q="$wq"
		if [[ $rc -eq 2 ]]; then
			pa_sandbox_die "$2 path '$1' goes through a symlink inside the writable workspace; refusing"
			return 1
		fi
		if [[ $rc -eq 0 ]] && _into_ws "$1" "$q"; then
			pa_sandbox_die "$2 path '$1' goes through a symlink that leads into the workspace; refusing"
			return 1
		fi
		if [[ $rc -ne 0 || ! -d "$q" ]]; then
			pa_sandbox_die "$2 does not resolve to an existing directory; refusing"
			return 1
		fi
		for pp in "${wdot[@]}"; do gdot+=("$pp"$'\t'"$2: '$1'"); done
		for pp in "${prot[@]}"; do
			pa_sandbox_within "$q" "$pp" && return 0
		done
		if pa_sandbox_within "$q" "$repo"; then
			_ro "$q"
			prot+=("$q")
			return 0
		fi
		pa_sandbox_die "$2 points to '$q' outside the workspace and outside protected git dirs; refusing"
		return 1
	}
	_protect_path() { # <abs path> <label>: a file/dir host git reads or runs; may not exist yet
		local q pp rc=0
		_walk "$1" || rc=$?
		q="$wq"
		if [[ $rc -ne 0 ]]; then
			pa_sandbox_die "$2: '$1' goes through a symlink inside the writable workspace or cannot be resolved; refusing"
			return 1
		fi
		if _into_ws "$1" "$q"; then
			pa_sandbox_die "$2: '$1' goes through a symlink that leads into the workspace; refusing"
			return 1
		fi
		for pp in "${wdot[@]}"; do gdot+=("$pp"$'\t'"$2: '$1'"); done
		_hl "$q" || return 1
		for pp in "${prot[@]}"; do
			pa_sandbox_within "$q" "$pp" && return 0
		done
		if pa_sandbox_within "$q" "$repo"; then
			if [[ "$q" == "$repo" ]]; then
				pa_sandbox_die "$2: '$1' is the workspace root itself; refusing"
				return 1
			elif [[ -e "$q" ]]; then
				_ro "$q"
				prot+=("$q")
			elif [[ "${q#"$repo"/}" != */* ]]; then
				pa_sandbox_die "$2: '$q' does not exist and sits directly under the workspace root (the sandbox could create it); refusing"
				return 1
			else
				cfgp+=("$q") # missing: its top-level ancestor is ro-bound below (ANCESTORS)
			fi
			return 0
		fi
		if _rw "$q"; then
			pa_sandbox_die "$2: '$q' is in a sandbox-writable state path; refusing"
			return 1
		fi
		return 0
	}
	_abs() { # <value> <base dir> -> absolute path (git: `~/` is the host HOME)
		case "$1" in
		/*) printf '%s\n' "$1" ;;
		\~/*) printf '%s\n' "$home/${1#\~/}" ;;
		\~) printf '%s\n' "$home" ;;
	\~*) return 1 ;; # ~user: not supported, the caller refuses
		*) printf '%s\n' "$2/$1" ;;
		esac
	}
	# _cfg_read <file> <depth>: append the entries of <file> to ek/ev, following
	# include.path and includeIf.*.path ourselves (`git config --file --no-includes`;
	# `--includes` would silently skip a missing target and an includeIf whose condition
	# is false now, both of which can become live later). Every include target is
	# protected. `git config --file` only parses the file (no fsmonitor, no hooks).
	local ncfg=0
	_cfg_read() {
		local f="$1" ent k v inc tmp frc=0 bad=0
		ncfg=$((ncfg + 1))
		if [[ $2 -gt 10 || $ncfg -gt 1000 ]]; then
			pa_sandbox_die "git config includes too deep or too many (loop?) at '$f'; refusing"
			return 1
		fi
		[[ -e "$f" ]] || return 0 # missing: protected by the caller, cannot appear inside
		if [[ ! -f "$f" ]]; then
			pa_sandbox_die "git config file '$f' is not a regular file; refusing"
			return 1
		fi
		tmp="$(mktemp)"
		(cd / && git config --file "$f" --no-includes -z --list) >"$tmp" 2>/dev/null || frc=$?
		if [[ $frc -ne 0 ]]; then
			command rm -f "$tmp"
			pa_sandbox_die "cannot parse git config '$f'; refusing"
			return 1
		fi
		while IFS= read -r -d '' ent; do
			k="${ent%%$'\n'*}"
			v=""
			[[ "$ent" == *$'\n'* ]] && v="${ent#*$'\n'}"
			ek+=("$k")
			ev+=("$v")
			ed+=("${f%/*}")
			case "$k" in
			include.path | includeif.*.path)
				if ! inc="$(_abs "$v" "$(dirname "$f")")" || ! _protect_path "$inc" "include in $f"; then
					pa_sandbox_die "cannot protect include '$v' in '$f'; refusing" || true
					bad=1
					break
				fi
				_cfg_read "$inc" $(($2 + 1)) || {
					bad=1
					break
				}
				;;
			esac
		done <"$tmp"
		command rm -f "$tmp"
		return "$bad"
	}
	# host global + system config (outside the sandbox's reach, but a RELATIVE hooksPath
	# or script path there resolves into each worktree). Every path git var names is
	# protected, a MISSING one too (GIT_CONFIG_GLOBAL=<ws>/conf/gitconfig,
	# $XDG_CONFIG_HOME/git/config): host git trusts a file the sandbox creates there.
	local hf
	while IFS= read -r hf; do
		[[ -n "$hf" && "$hf" != /dev/null ]] || continue # unset (GIT_CONFIG_NOSYSTEM) or /dev/null
		_protect_path "$hf" "host git config" || return 1
		[[ ! -f "$hf" ]] || _cfg_read "$hf" 0 || return 1
	done < <(git var GIT_CONFIG_GLOBAL 2>/dev/null; git var GIT_CONFIG_SYSTEM 2>/dev/null)
	gk=("${ek[@]}")
	gv=("${ev[@]}")
	gdd=("${ed[@]}")
	# _scan_links <dir> <depth>: every symlink under a git control dir (hooks/, config,
	# commondir, gitdir, info/, worktrees/*, ...) or a hooksPath dir must lead OUTSIDE the
	# workspace and the rw state dirs (SYMLINKED GIT CONTROL FILES in the header).
	_scan_links() {
		local l t q d rc lst err frc=0 bad=0
		[[ -d "$1" ]] || return 0
		if [[ $2 -gt 4 ]]; then
			pa_sandbox_die "symlinked directories nested too deep under '$1'; refusing"
			return 1
		fi
		lst="$(mktemp)"
		err="$(mktemp)"
		# symlinks, and regular files with more than one hard link (HARD LINKS)
		find -P "$1" \( -type l -printf 'L%p\0' \) -o \( -type f -links +1 -printf 'F%D:%i\t%p\0' \) >"$lst" 2>"$err" || frc=$?
		if [[ $frc -ne 0 || -s "$err" ]]; then
			pa_sandbox_die "scan for symlinks under '$1' failed (rc=$frc): $(head -c 400 "$err"); refusing"
			command rm -f "$lst" "$err"
			return 1
		fi
		command rm -f "$err"
		while IFS= read -r -d '' l; do
			if [[ "$l" == F* ]]; then
				hl+=("${l#F}")
				continue
			fi
			l="${l#L}"
			rc=0
			t="$(readlink -- "$l")" || rc=1
			[[ "$t" == /* ]] || t="${l%/*}/$t"
			[[ $rc -eq 0 ]] && { _walk "$t" || rc=$?; }
			q="$wq"
			if [[ $rc -ne 0 ]] || pa_sandbox_within "$q" "$repo" || _rw "$q"; then
				pa_sandbox_die "symlinked git control file '$l' leads into the writable workspace or state (it could be rewritten from inside), or cannot be resolved; refusing"
				bad=1
				break
			fi
			for d in "${wdot[@]}"; do gdot+=("$d"$'\t'"symlinked git control file '$l': '$t'"); done
			if ! _hl "$q" || { [[ -d "$q" ]] && ! _scan_links "$q" $(($2 + 1)); }; then
				bad=1
				break
			fi
		done <"$lst"
		command rm -f "$lst"
		return "$bad"
	}
	# _words <value>: the words of a config value that may name a path -> wl ("a:word"; "v:word"
	# for a word right after a $... expansion; "i:word" for a word a shell/interpreter opens
	# relative to the CURRENT directory; "u:" for such a word that is an expansion; "e:" for a
	# word with its = , kept, protected only when it exists).
	# Splitting/exclusions/positions: header. ireg: commands whose arguments are scripts,
	# modules or sourced files; wreg: wrappers that run their arguments as a command.
	local ireg='sh|bash|dash|zsh|ksh|mksh|ash|yash|fish|csh|tcsh|busybox|python[0-9.]*|pypy[0-9.]*|perl[0-9.]*|ruby[0-9.]*|node|nodejs|deno|bun|bunx|tsx|ts-node|php[0-9.]*|lua[0-9.]*|luajit|tclsh[0-9.]*|wish[0-9.]*|Rscript|awk|gawk|mawk|nawk|sed|source|\.|go|uv|uvx|npx|java|pwsh'
	local wreg='env|exec|command|builtin|eval|nice|nohup|timeout|xargs|stdbuf|time|setsid|ionice|chrt|flock|sudo|doas'
	# _wsplit <shell text>: its words with the markers below -> parts (the caller's local)
	_wsplit() {
		local v="$1" nl=$'\n' re='\$\{[^}]*\}|\$[A-Za-z_][A-Za-z0-9_]*|\$[0-9@*#?!$-]'
		v="${v//[\"\']/}"
		v="${v//\$\{HOME\}/\~}"
		v="${v//\$HOME/\~}"
		while [[ "$v" == *'`'*'`'* ]]; do # `cmd` is $(cmd)
			v="${v/\`/\$(}"
			v="${v/\`/)}"
		done
		v="${v//\`/\$(}"
		# markers: \002 opens a nested command ( $( ( { ), \004 closes it, \005 starts the
		# next command ( ; & | newline ), \006 redirection, \007 `=`, \001 an expansion
		v="${v//\$(/ $'\002' }"
		while [[ "$v" =~ $re ]]; do
			v="${v/"${BASH_REMATCH[0]}"/ $'\001'}"
		done
		v="${v//[(\{]/ $'\002' }"
		v="${v//[)\}]/ $'\004' $'\001'}"
		v="${v//[;&|]/ $'\005' }"
		v="${v//"$nl"/ $'\005' }"
		v="${v//[<>]/ $'\006' }"
		v="${v//=/$'\007'}"
		v="${v//,/$'\010'}"
		read -ra parts -d '' <<<"$v" || true
	}
	_words() {
		local v="$1" w t k p q1 q2 cls="" rd=0 ip
		local -a parts=() st=() sub=()
		wl=()
		v="${v#!}"
		q1="${v//[^\"]/}"
		q2="${v//[^\']/}"
		if [[ $((${#q1} % 2)) -ne 0 || $((${#q2} % 2)) -ne 0 ]]; then
			wl+=("a:$v") # unbalanced quotes: cannot split, the whole value is a word too
		fi
		_wsplit "$v"
		for t in "${parts[@]}"; do
			case "$t" in
			$'\002')
				st+=("$cls")
				cls=""
				rd=0
				continue
				;;
			$'\004')
				if [[ ${#st[@]} -gt 0 ]]; then
					cls="${st[-1]}"
					unset 'st[-1]'
				else
					cls=i # unbalanced: the enclosing command is unknown
				fi
				continue
				;;
			$'\005')
				cls=""
				rd=0
				continue
				;;
			$'\006')
				rd=1
				continue
				;;
			esac
			k=a
			[[ "$t" == $'\001'* ]] && k=v
			t="${t//$'\001'/}"
			w="${t##*/}"
			# cls: "" = next word is the command, i = interpreter, w = wrapper, o = other
			ip=0
			if [[ -z "$cls" ]]; then
				if [[ $rd -eq 1 ]]; then
					ip=1 # `<file cmd`: opened relative to the current directory
				elif [[ "$t" == *$'\007'* ]]; then
					: # VAR=value before the command
				elif [[ $k == v || -z "$t" ]]; then
					cls=i # the command comes from an expansion: unknown
				elif [[ "$w" =~ ^($wreg)$ ]]; then
					cls=w
				elif [[ "$w" =~ ^($ireg)$ ]]; then
					cls=i
				else
					cls=o
				fi
			elif [[ $cls == i ]]; then
				ip=1
			elif [[ $cls == w ]]; then
				if [[ "$w" =~ ^($ireg)$ ]]; then
					cls=i
				elif [[ ! ("$w" =~ ^($wreg)$ || "$t" == -* || "$t" == *$'\007'* || "$t" =~ ^[0-9]+(\.[0-9]+)?[smhd]?$) ]]; then
					ip=1
				fi
			fi
			rd=0
			if [[ $ip -eq 1 && $k == v && "$t" != */* ]]; then
				wl+=("u:$t") # an expansion names the file: cannot tell which
				continue
			fi
			sub=()
			IFS=$'\007\010' read -ra sub <<<"$t" || true
			for w in "${sub[@]}"; do
				_wadd "$w" "$k"
			done
			p="${t//$'\007'/=}"
			p="${p//$'\010'/,}"
			[[ "$p" == "$t" ]] || _wadd "$p" e # the word with its = , kept (a name may contain them)
		done
	}
	# _wx <word>: 1 when the exclusion rules (header) say it is no path; else wx = the word
	_wx() {
		wx="$1"
		case "$wx" in
		"" | . | refs/* | +refs/* | ^refs/*) return 1 ;;
		file://*)
			wx="${wx#file://}"
			wx="${wx#localhost}"
			[[ "$wx" == /* ]] || return 1 # file://otherhost/...: not local
			;;
		esac
		[[ "$wx" =~ ^[A-Za-z][A-Za-z0-9+.-]*:// ]] && return 1 # URL with a scheme
		[[ "$wx" =~ ^[^/]*: ]] && return 1                     # host:path, a:b refspec, format:
		[[ "$wx" =~ [^/]\.\.|\.\.[^/] ]] && return 1           # revision range a..b
		return 0
	}
	# _wadd <word> <kind>: add one word of _words (ip: its interpreter position) to wl, plus
	# the value of an attached short option (-Xvalue -> value, same kind)
	_wadd() {
		local w
		_wx "$1" || return 0
		w="$wx"
		if [[ $ip -eq 1 && $k == a && "$w" != -* && ! "$w" =~ ^%[A-Za-z]$ ]]; then
			wl+=("i:$w")
		else
			wl+=("$2:$w")
		fi
		[[ "$w" =~ ^-[A-Za-z0-9][^=] ]] && _wx "${w:2}" && wl+=("$2:$wx")
		return 0
	}
	# _pp <abs path> <key>: _protect_path once per path AS WRITTEN (pdone is keyed on the
	# unnormalised path: `tools/../hooks/x` is walked for `..` even when `hooks/x` was done);
	# a worktree root itself is skipped (e.g. safe.directory: git never runs a directory, and
	# it cannot be made read-only) -- only the root found from the layout, not a core.worktree
	# value (config union) -- but one reached through `..` is still walked for its hops
	_pp() {
		local n r pp rc=0
		[[ -z "${pdone[$1]:-}" ]] || return 0
		pdone[$1]=1
		n="$(realpath -s -m -- "$1")" || return 1
		for r in "${roots[0]}" "$repo"; do
			[[ "$n" == "$r" ]] || continue
			[[ "$1/" == */../* ]] || return 0
			_walk "$1" || rc=$?
			if [[ $rc -ne 0 ]]; then
				pa_sandbox_die "$2 in the config of '$g': '$1' goes through a symlink inside the writable workspace or cannot be resolved; refusing"
				return 1
			fi
			for pp in "${wdot[@]}"; do gdot+=("$pp"$'\t'"$2 in the config of '$g': '$1'"); done
			return 0
		done
		_protect_path "$1" "$2 in the config of '$g'" || {
			pa_sandbox_die "cannot protect '$1' named by $2 (config of '$g'); refusing" || true
			return 1
		}
	}
	# _cand <word> <kind> <key> <config dir>: protect what one config word may name (header)
	_cand() {
		local t="$1" b n rel=""
		if [[ "$2" == u ]]; then
			pa_sandbox_die "an interpreter argument in $3 (config of '$g') is a variable/command expansion ('$t...'): cannot tell which file it names; refusing"
			return 1
		fi
		if [[ "$2" == e ]]; then # only an EXISTING entry (VALUE CANDIDATES in the header)
			case "$t" in
			/* | \~*)
				n="$(_abs "$t" /)" || return 0
				[[ -e "$n" || -L "$n" ]] && { _pp "$n" "$3" || return 1; }
				return 0
				;;
			esac
			for b in "${roots[@]}" "$4"; do
				[[ -e "$b/$t" || -L "$b/$t" ]] && { _pp "$b/$t" "$3" || return 1; }
			done
			return 0
		fi
		case "$t" in
		/* | \~*)
			if ! n="$(_abs "$t" /)"; then
				pa_sandbox_die "unsupported path '$t' named by $3 (config of '$g'); refusing"
				return 1
			fi
			_pp "$n" "$3" || return 1
			[[ "$2" == v && "$t" == /* ]] || return 0
			rel="$t" # right after a $... expansion: maybe relative to a base as well
			while [[ "$rel" == /* ]]; do rel="${rel#/}"; done
			[[ -n "$rel" ]] || return 0
			;;
		*) rel="$t" ;;
		esac
		for b in "${roots[@]}" "$4"; do
			# a word without / counts when it exists, or when an interpreter opens it (i)
			[[ "$rel" == */* || -e "$b/$rel" || -L "$b/$rel" || "$2" == i ]] || continue
			# <remote>/<x> with no <remote> entry in the base: a remote-tracking ref (rem: what
			# host git resolves, REMOTE NAMES in the header; never for an interpreter argument)
			[[ "$2" != i && "$rel" == */* && -n "${rem[${rel%%/*}]:-}" && ! -e "$b/${rel%%/*}" && ! -L "$b/${rel%%/*}" ]] && continue
			_pp "$b/$rel" "$3" || return 1
		done
	}
	# _nonpath <key> <word>: a ONE-WORD value that is no path (SINGLE WORDS in the header)
	_nonpath() {
		case "$1" in
		# a remote name that host git does not resolve (_rname): git uses it as a URL, i.e. a
		# path relative to the current directory
		branch.*.remote | branch.*.pushremote | remote.pushdefault | checkout.defaultremote | extensions.partialclone) return 1 ;;
		# path-type names: no option / key-id exemption (git opens `-x` or `deadbeef` as a file)
		gc.repackfilterto | *file | *path | *dir | *.ssl* | *.template) return 1 ;;
		esac
		[[ "$2" == -* || "$2" =~ ^(0[xX])?[0-9A-Fa-f]{8,40}!?$ ]] && return 0 # option, GPG key id
		case "$1" in
		# a command name: git looks it up in PATH (or runs a git subcommand / helper)
		alias.* | *.editor | core.pager | pager.* | *.program | *.cmd | *.command | *.helper | *.driver | \
			*.textconv | *.clean | *.smudge | *.process | *.tool | *.guitool | core.sshcommand | core.askpass | \
			core.fsmonitor | core.gitproxy | *.defaultkeycommand | *.receivepack | *.uploadpack | *.sendmailcmd | \
			diff.external | web.browser) return 0 ;;
		# names, e-mail addresses, enums, ref / remote / branch names
		user.name | user.email | author.* | committer.* | *.name | *.username | credential.* | url.* | \
			branch.* | remote.*.push | remote.*.fetch | remote.*.vcs | remote.*.tagopt | \
			init.defaultbranch | color.* | column.* | push.* | pull.* | merge.* | rebase.* | \
			log.* | status.* | gc.* | extensions.* | protocol.* | gpg.format | *.sort | diff.algorithm | \
			diff.colormoved | diff.colormovedws | diff.submodule | diff.dirstat | diff.wserrorhighlight | diff.renames | \
			fetch.recursesubmodules | fetch.negotiationalgorithm | submodule.recurse | submodule.*.update | \
			submodule.*.ignore | submodule.*.branch | core.autocrlf | core.safecrlf | core.eol | core.whitespace | \
			core.checkstat | core.abbrev | core.logallrefupdates | core.fsync | core.fsyncmethod | \
			receive.denycurrentbranch | receive.denydeletecurrent | commit.cleanup | grep.patterntype | \
			blame.coloring | blame.date | maintenance.strategy | format.pretty | help.autocorrect) return 0 ;;
		esac
		return 1
	}
	# _gq <git dir> <args>: host git itself, read-only, with the caller's config environment
	# (HOME, GIT_CONFIG_GLOBAL/NOSYSTEM/COUNT/PARAMETERS) but no inherited repo selection;
	# `git remote` / `git remote get-url` only parse config (REMOTE NAMES in the header)
	_gq() {
		local d="$1"
		shift
		(cd / && env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR -u GIT_INDEX_FILE \
			-u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES -u GIT_NAMESPACE \
			GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0 GIT_OPTIONAL_LOCKS=0 \
			git --no-pager -c core.fsmonitor=false --git-dir="$d" "$@")
	}
	# _rurl <url>: 0 and wx = the path when host git uses <url> as a LOCAL path (transport.c:
	# file://, else no <scheme>:// or <helper>:: and no `:` before the first `/`)
	_rurl() {
		wx="$1"
		case "$wx" in
		file://*)
			wx="${wx#file://}"
			wx="${wx#localhost}"
			[[ "$wx" == /* ]]
			return
			;;
		esac
		[[ -n "$wx" && ! "$wx" =~ ^[A-Za-z][A-Za-z0-9+.-]*(://|::) && ! "$wx" =~ ^[^/]*: ]]
	}
	# _rname <name>: resolve a remote name with host git (fetch and push URLs, after
	# insteadOf). rq[name] = 0: every URL is remote, 1: a URL is a local path (in rl[name]),
	# 2: no such remote (git uses the name itself as the URL; also when `git remote` failed
	# for this git dir). 1 on a git error.
	_rname() {
		local u o e rc p
		[[ -z "${rq[$1]+x}" ]] || return 0
		rq[$1]=0
		rl[$1]=""
		[[ $rok -eq 1 ]] || { rq[$1]=2 && return 0; }
		e="$(mktemp)"
		for p in "" --push; do
			rc=0
			o="$(_gq "$g" remote get-url $p --all -- "$1" 2>"$e")" || rc=$?
			if [[ $rc -eq 2 ]]; then
				rq[$1]=2
				break
			elif [[ $rc -ne 0 ]]; then
				pa_sandbox_die "host git cannot resolve remote '$1' (config of '$g', rc=$rc): $(head -c 400 "$e"); refusing"
				command rm -f "$e"
				return 1
			fi
			while IFS= read -r u; do
				_rurl "$u" && rq[$1]=1 && rl[$1]+="$wx"$'\n'
			done <<<"$o"
		done
		command rm -f "$e"
	}
	# _gmem <group>: gm = the number of members host git reads for remotes.<group> (words
	# split like git; 0 when unset or when `git remote` failed for this git dir). 1 on a
	# git error.
	_gmem() {
		local o rc=0
		local -a m=()
		gm=0
		[[ $rok -eq 1 ]] || return 0
		o="$(_gq "$g" config --get-all "remotes.$1" 2>/dev/null)" || rc=$?
		if [[ $rc -ne 0 && $rc -ne 1 ]]; then
			pa_sandbox_die "host git cannot read remote group '$1' (config of '$g', rc=$rc); refusing"
			return 1
		fi
		IFS=$' \t\n' read -r -d '' -a m <<<"$o" || true
		gm=${#m[@]}
	}
	# _git_ctx <git dir> <worktree root>
	local -A gdone=()
	_git_ctx() {
		local g c f i n r t k v w sw wx d e lst err frc gm
		local -a roots=("$2") files=() ws=()
		local -A rem=() rq=() rl=() rn=() grp=()
		local rok=0
		_protect_dir "$1" "git dir of '$2'" || return 1
		_walk "$1" || return 1
		g="$wq"
		[[ -z "${gdone[$g|$2]:-}" ]] || return 0 # same git dir + root already done (worktrees/* loop)
		gdone[$g|$2]=1
		_scan_links "$g" 0 || return 1
		c="$g"
		if [[ -f "$g/commondir" ]]; then
			c="$(head -n1 "$g/commondir")"
			[[ "$c" == /* ]] || c="$g/$c"
			_protect_dir "$c" "commondir of '$g'" || return 1
			_walk "$c" || return 1
			c="$wq"
			[[ "$c" == "$g" ]] || _scan_links "$c" 0 || return 1
		fi
		ek=("${gk[@]}")
		ev=("${gv[@]}")
		ed=("${gdd[@]}")
		ncfg=0
		files=("$c/config" "$g/config.worktree")
		[[ "$c" != "$g" ]] && files+=("$g/config" "$c/config.worktree")
		for f in "${files[@]}"; do
			_protect_path "$f" "git config file" && _cfg_read "$f" 0 || return 1
		done
		# core.worktree (relative to the git dir) moves the worktree root
		for i in "${!ek[@]}"; do
			[[ "${ek[$i]}" == core.worktree && -n "${ev[$i]}" ]] || continue
			if ! r="$(_abs "${ev[$i]}" "$g")"; then
				pa_sandbox_die "unsupported core.worktree '${ev[$i]}' (config of '$g'); refusing"
				return 1
			fi
			# host git chdirs into it (hooks, submodule .git files under it): walked as written
			# for `..` IN GIT PATHS, like every other git path
			frc=0
			_walk "$r" || frc=$?
			if [[ $frc -ne 0 ]]; then
				pa_sandbox_die "core.worktree in the config of '$g': '$r' goes through a symlink inside the writable workspace or cannot be resolved; refusing"
				return 1
			fi
			for d in "${wdot[@]}"; do gdot+=("$d"$'\t'"core.worktree in the config of '$g': '$r'"); done
			roots+=("$r")
		done
		# EVERY remote name host git may know (REMOTE NAMES in the header): `git remote`, the
		# remote.<name>.* sections of every config file read, the legacy remotes/<name> and
		# branches/<name> files of the git dir and common dir (rn: 2 = listed by `git remote`);
		# each is resolved here and protected after the per-key loop below.
		# A git dir host git does not accept (e.g. an empty nested .git): every name is a path.
		rok=1
		t="$(_gq "$g" remote 2>/dev/null)" || {
			rok=0
			t=""
		}
		while IFS= read -r n; do
			[[ -n "$n" ]] && rn[$n]=2
		done <<<"$t"
		for k in "${ek[@]}"; do
			[[ "$k" == remote.*.* ]] || continue
			n="${k#remote.}"
			n="${n%.*}"
			[[ -n "$n" ]] && rn[$n]="${rn[$n]:-1}"
		done
		for d in "$g/remotes" "$g/branches" "$c/remotes" "$c/branches"; do
			[[ -e "$d" || -L "$d" ]] || continue
			if [[ -L "$d" || ! -d "$d" ]]; then
				pa_sandbox_die "legacy remote dir '$d' is a symlink or not a directory; refusing"
				return 1
			fi
			lst="$(mktemp)"
			err="$(mktemp)"
			frc=0
			find -P "$d" -mindepth 1 ! -type d \( -type f -printf 'F%P\0' -o -printf 'X%P\0' \) >"$lst" 2>"$err" || frc=$?
			if [[ $frc -ne 0 || -s "$err" ]] || grep -qz '^X' "$lst"; then
				pa_sandbox_die "scan of legacy remote dir '$d' failed or found a symlink / special file (rc=$frc): $(head -c 400 "$err"); refusing"
				command rm -f "$lst" "$err"
				return 1
			fi
			while IFS= read -r -d '' e; do
				e="${e#F}"
				[[ -n "$e" ]] && rn[$e]="${rn[$e]:-1}"
			done <"$lst"
			command rm -f "$lst" "$err"
		done
		# remote groups (REMOTE NAMES in the header): every word of every remotes.<group>
		# value (split like git: space, tab, newline) and every <group> (rn 3 when known only
		# from a group; grp: the group keys exactly as git compares them)
		for i in "${!ek[@]}"; do
			[[ "${ek[$i]}" == remotes.?* ]] || continue
			n="${ek[$i]#remotes.}"
			grp[$n]=1
			rn[$n]="${rn[$n]:-3}"
			IFS=$' \t\n' read -r -d '' -a ws <<<"${ev[$i]}" || true
			for w in "${ws[@]}"; do
				rn[$w]="${rn[$w]:-3}"
			done
		done
		for n in "${!rn[@]}"; do
			_rname "$n" || return 1
			[[ ${rq[$n]} -eq 0 && ${rn[$n]} -eq 2 ]] && rem[$n]=1 # listed by `git remote` (see _cand)
		done
		# EVERY value of EVERY key (CONFIG REFERENCES in the header; no list of path keys)
		for i in "${!ek[@]}"; do
			k="${ek[$i]}"
			v="${ev[$i]}"
			case "$k" in
			include.path | includeif.*.path | core.worktree | remotes.*) continue ;; # handled above
			core.hookspath)                                             # relative: to the worktree root (githooks(5))
				[[ -n "$v" ]] || continue
				for r in "${roots[@]}"; do
					if ! f="$(_abs "$v" "$r")" || ! _protect_path "$f" "core.hooksPath in the config of '$g'"; then
						pa_sandbox_die "cannot protect hooks dir '$v' named by core.hooksPath (config of '$g'); refusing" || true
						return 1
					fi
					_walk "$f" && _scan_links "$wq" 0 || return 1
				done
				continue
				;;
			branch.*.remote | branch.*.pushremote | remote.pushdefault | checkout.defaultremote | extensions.partialclone)
				# a remote name: protect the local URLs host git resolves it to; a name git does
				# not resolve is a path itself (falls through, _nonpath)
				if [[ -n "$v" ]]; then
					_rname "$v" || return 1
					if [[ ${rq[$v]} -ne 2 ]]; then
						while IFS= read -r t; do
							[[ -z "$t" ]] || _cand "$t" i "$k (URL of remote '$v')" "${ed[$i]}" || return 1
						done <<<"${rl[$v]}"
						continue
					fi
				fi
				;;
			url.*.insteadof | url.*.pushinsteadof)
				# the <base> in the KEY replaces a URL prefix: a local base (_rurl; an empty one
				# leaves the suffix, a relative path) turns the remote into the string base+suffix,
				# a path that cannot be told in advance. An absolute base is walked as written
				# (`..` IN GIT PATHS): host git applies its `..` hops to the directories it finds then.
				t="${k#url.}"
				t="${t%.*}"
				n=""
				wx=""
				if [[ -z "$t" ]] || _rurl "$t"; then
					n=-
					if [[ "$wx" == [/~]* ]] && w="$(_abs "$wx" /)"; then
						frc=0
						_walk "$w" || frc=$?
						if [[ $frc -ne 0 ]]; then
							pa_sandbox_die "$k in the config of '$g': '$w' goes through a symlink inside the writable workspace or cannot be resolved; refusing"
							return 1
						fi
						for d in "${wdot[@]}"; do gdot+=("$d"$'\t'"$k in the config of '$g': '$w'"); done
						n="$wq"
					fi
				fi
				for r in "${rwp[@]}"; do
					[[ -z "$n" || ("$n" != - && "$n" != "$r" && "$n" != "$r"/* && "$r" != "$n"*) ]] && continue
					pa_sandbox_die "url.<base>.insteadOf base '$t' (config of '$g') is a relative path or a prefix of / a path in the workspace or a state path: the remote it rewrites to cannot be protected; refusing"
					return 1
				done
				;;
			esac
			[[ -z "$v" || "${v,,}" =~ ^(true|false|yes|no|on|off)$ || "$v" =~ ^-?[0-9]+(\.[0-9]+)?[kKmMgG]?$ || "$v" == key::* ]] && continue
			_words "$v"
			# the whole value (VALUE CANDIDATES in the header); ONE word (no whitespace, no `!`)
			# names a path even when missing, unless _nonpath (SINGLE WORDS in the header)
			t="${v#"${v%%[![:space:]]*}"}"
			t="${t%"${t##*[![:space:]]}"}"
			t="${t#:(optional)}" # git-config(1) pathname: ignored when missing
			sw=0
			[[ "$t" != *[[:space:]]* && "$t" != '!'* && "$t" != '%(prefix)/'* ]] && ! _nonpath "$k" "$t" && sw=1
			_wx "$t" && wl+=("w:$wx")
			for w in "${wl[@]}"; do
				[[ $sw -eq 1 && "$w" == w:* ]] && w="i:${w#w:}"
				[[ "$w" == w:* ]] && w="e:${w#w:}"
				_cand "${w#?:}" "${w%%:*}" "$k" "${ed[$i]}" || return 1
			done
		done
		# the local URLs of every remote name collected above, or the name itself when host git
		# uses it as a path (after the per-key checks, whose refusals are more specific)
		for n in "${!rn[@]}"; do
			case "${rq[$n]}" in
			0) ;;
			1)
				while IFS= read -r t; do
					[[ -z "$t" ]] || _cand "$t" i "URL of remote '$n'" "$2" || return 1
				done <<<"${rl[$n]}"
				;;
			*)
				# a name known only from groups that host git reads as a group of 2+ members:
				# fetch / remote update expand it, never a path (fewer: `git fetch <group>`
				# uses the name itself)
				if [[ ${rn[$n]} -eq 3 && -n "${grp[$n]:-}" ]]; then
					_gmem "$n" || return 1
					[[ $gm -ge 2 ]] && continue
				fi
				_cand "$n" i "remote name '$n' (host git uses it as a path)" "$2" || return 1
				;;
			esac
		done
		_sub_ctx "$g" "$c" "$2"
	}
	# _sub_ctx <git dir> <common dir> <worktree root>: the git dirs git keeps INSIDE a git dir
	# -- submodule git dirs under modules/ (outermost; nested ones through the recursion) and
	# linked-worktree admin dirs worktrees/* -- get _git_ctx with their own worktree root
	# (SUBMODULE / WORKTREE GIT DIRS in the header). Any doubt refuses.
	_sub_ctx() {
		local d e n p r ent k v lst err frc tmp gmok=0
		local -a found=() outer=() sl=() kids=() kroots=()
		local -A gm=()
		for d in "$1/modules" "$2/modules"; do
			[[ -d "$d" ]] || continue
			lst="$(mktemp)"
			err="$(mktemp)"
			frc=0
			find -P "$d/" \( -type l -xtype d -printf 'L%p\0' \) -o \( -name HEAD -printf 'H%h\0' \) >"$lst" 2>"$err" || frc=$?
			if [[ $frc -ne 0 || -s "$err" ]]; then
				pa_sandbox_die "scan of '$d' for submodule git dirs failed (rc=$frc): $(head -c 400 "$err"); refusing"
				command rm -f "$lst" "$err"
				return 1
			fi
			command rm -f "$err"
			while IFS= read -r -d '' e; do
				if [[ "$e" == L* ]]; then
					sl+=("${e#L}")
					continue
				fi
				e="${e#H}"
				e="${e%/}"
				[[ -e "$e/objects" || -L "$e/objects" || -e "$e/refs" || -L "$e/refs" || -e "$e/commondir" || -L "$e/commondir" ]] || continue
				found+=("$d"$'\t'"$e")
			done <"$lst"
			command rm -f "$lst"
		done
		for e in "${found[@]}"; do
			for k in "${found[@]}"; do
				[[ "${e#*$'\t'}" == "${k#*$'\t'}"/* ]] && continue 2
			done
			outer+=("$e")
		done
		for e in "${sl[@]}"; do # a symlinked dir outside every submodule git dir could hide one
			for k in "${outer[@]}"; do
				[[ "$e" == "${k#*$'\t'}"/* ]] && continue 2
			done
			pa_sandbox_die "symlinked directory '$e' under a modules/ dir (it could hold a submodule git dir that is not scanned); refusing"
			return 1
		done
		for e in "${outer[@]}"; do
			d="${e%%$'\t'*}"
			e="${e#*$'\t'}"
			n="${e#"$d"/}"
			if [[ $gmok -eq 0 && (-e "$3/.gitmodules" || -L "$3/.gitmodules") ]]; then
				tmp="$(mktemp)"
				frc=0
				(cd / && git config --file "$3/.gitmodules" --no-includes -z --list) >"$tmp" 2>/dev/null || frc=$?
				if [[ $frc -ne 0 ]]; then
					command rm -f "$tmp"
					pa_sandbox_die "cannot parse '$3/.gitmodules' (needed to find the worktree of submodule git dirs under '$d'); refusing"
					return 1
				fi
				while IFS= read -r -d '' ent; do
					k="${ent%%$'\n'*}"
					v=""
					[[ "$ent" == *$'\n'* ]] && v="${ent#*$'\n'}"
					[[ "$k" == submodule.*.path ]] || continue
					k="${k#submodule.}"
					gm[${k%.path}]="$v"
				done <"$tmp"
				command rm -f "$tmp"
			fi
			gmok=1
			p="${gm[$n]:-$n}" # name -> path from .gitmodules, else the name is the path
			if [[ -z "$n" || "$e" == "$d" || -z "$p" || "$p" == /* || "/$p/" == */../* || "/$p/" == */./* || "$p" == *$'\n'* ]]; then
				pa_sandbox_die "cannot tell the worktree of submodule git dir '$e' (path '$p'); refusing"
				return 1
			fi
			nn=$((nn + 1))
			if [[ $nn -gt $PA_SANDBOX_MAX_NESTED_GIT ]]; then
				pa_sandbox_die "more than $PA_SANDBOX_MAX_NESTED_GIT nested git dirs under '$repo'; refusing (raise PA_SANDBOX_MAX_NESTED_GIT to accept)"
				return 1
			fi
			kids+=("$e")
			kroots+=("$3/$p")
		done
		for d in "$2/worktrees" "$1/worktrees"; do
			[[ -d "$d" ]] || continue
			lst="$(mktemp)"
			err="$(mktemp)"
			frc=0
			find "$d/" -mindepth 1 -maxdepth 1 -print0 >"$lst" 2>"$err" || frc=$?
			if [[ $frc -ne 0 || -s "$err" ]]; then
				pa_sandbox_die "listing of '$d' failed (rc=$frc): $(head -c 400 "$err"); refusing"
				command rm -f "$lst" "$err"
				return 1
			fi
			command rm -f "$err"
			# shellcheck disable=SC2094 # the rm in the refusal branch runs right before `return`
			while IFS= read -r -d '' e; do
				[[ -d "$e" ]] || continue
				r=""
				[[ -f "$e/gitdir" ]] && r="$(head -n1 "$e/gitdir")"
				if [[ -z "$r" ]]; then
					pa_sandbox_die "worktree admin dir '$e' has no usable gitdir file: cannot tell its worktree; refusing"
					command rm -f "$lst"
					return 1
				fi
				[[ "$r" == /* ]] || r="$e/$r"
				kids+=("$e")
				kroots+=("${r%/*}")
			done <"$lst"
			command rm -f "$lst"
		done
		for e in "${!kids[@]}"; do
			_git_ctx "${kids[$e]}" "${kroots[$e]}" || return 1
		done
	}
	local gf gline gd
	if [[ -d "$repo/.git" && ! -L "$repo/.git" ]]; then
		_git_ctx "$repo/.git" "$repo" || return 1
	elif [[ -n "$tgd" ]]; then
		_git_ctx "$tgd" "$repo" || return 1
	fi
	for gd in "${gdirs[@]}"; do
		_git_ctx "$gd" "$(dirname "$gd")" || return 1
	done
	for gf in "${gfiles[@]}"; do
		gline="$(head -n1 "$gf")"
		if [[ "$gline" != "gitdir: "* ]]; then
			pa_sandbox_die "nested gitfile '$gf' has an unexpected format; refusing"
			return 1
		fi
		gd="${gline#gitdir: }"
		[[ "$gd" == /* ]] || gd="$(dirname "$gf")/$gd"
		_git_ctx "$gd" "$(dirname "$gf")" || return 1
	done
	# a bare repo's hooks run in the git dir itself (githooks(5)): it is its own root
	for gd in "${bares[@]}"; do
		_git_ctx "$gd" "$gd" || return 1
	done
	# HOME SYMLINKS (see header): a host file reached through the user's HOME (a symlink,
	# followed hop by hop, or a bind mount) that lands in the workspace is made read-only.
	local -a hmid=() hdot=() hsr=() hxr=() hex=() hpe=() hneed=() hpend=() hnext=() hfiles=() hst=()
	local hq="" hh hl2 hp ht hw herr2 herrs hcnt=0 hnro=0 hr i j k mi mr
	local -A hseen=() hrl=() hlab=()
	_hwalk() { # <abs path>: like _walk, but a symlink inside a writable area is recorded in
		# hmid (not refused), and link targets come from the hrl cache: an uncached link is
		# queued in hneed and the walk returns 3 (walked again after one batch read). Sets hq. A
		# directory strictly inside a writable area that a `..` leaves again is recorded in hdot
		# (checked per hop, before the `..` is applied to the text): the sandbox could replace it
		# by a symlink, so what the `..` names is not what pa-sandbox sees here.
		local cur="" c t n=0 rest="$1" w
		hq=""
		hmid=()
		hdot=()
		[[ "$1" == /* && "$1" != *$'\n'* ]] || return 1
		while [[ -n "$rest" ]]; do
			c="${rest%%/*}"
			[[ "$rest" == */* ]] && rest="${rest#*/}" || rest=""
			case "$c" in
			"" | .) continue ;;
			..)
				if [[ "$cur" == "$repo"/* ]]; then
					hdot+=("$cur")
				elif [[ "$cur" == "$agent_dir"/* ]]; then
					for w in "${rwp[@]}"; do
						[[ "$cur" == "$w"/* ]] && hdot+=("$cur") && break
					done
				fi
				cur="${cur%/*}"
				continue
				;;
			esac
			if [[ -L "$cur/$c" ]]; then
				if [[ "$cur/$c" == "$repo"/* || "$cur/$c" == "$agent_dir"/* ]] && _rw "$cur/$c"; then
					hmid+=("$cur/$c")
				fi
				if [[ -z "${hrl[$cur/$c]+x}" ]]; then
					hneed+=("$cur/$c")
					return 3
				fi
				n=$((n + 1))
				t="${hrl[$cur/$c]}"
				[[ $n -le 40 && -n "$t" && "$t" != *$'\n'* ]] || return 1
				[[ "$t" == /* ]] && cur=""
				rest="$t/$rest"
				continue
			fi
			cur="$cur/$c"
		done
		hq="${cur:-/}"
	}
	_hprot() { # <path> <is a symlink: 1|0> <label>: protect a resolved HOME reference
		local pp
		if [[ "$1" != "$repo" && "$1" != "$repo"/* ]]; then
			if [[ "$1" == "$agent_dir"/* ]] && _rw "$1"; then
				pa_sandbox_die "$3 resolves into the sandbox-writable state path '$1'; refusing"
				return 1
			fi
			return 0
		fi
		for pp in "${prot[@]}"; do
			[[ "$1" == "$pp" || "$1" == "$pp"/* ]] && return 0
		done
		if [[ "$1" == "$repo" ]]; then
			pa_sandbox_die "$3 resolves to the workspace root itself (the host reads the whole workspace through it); refusing"
			return 1
		fi
		hnro=$((hnro + 1))
		[[ ${#hex[@]} -ge 5 ]] || hex+=("$3 -> ${1#"$repo"/}")
		if [[ $2 -eq 0 && -e "$1" ]]; then
			[[ -f "$1" ]] && hfiles+=("$1") # HARD LINKS, checked in one batch below
			_ro "$1"
			prot+=("$1")
		elif [[ "${1#"$repo"/}" != */* ]]; then
			pa_sandbox_die "$3 resolves to '$1', which is $([[ $2 -eq 1 ]] && echo "a symlink" || echo "missing") directly under the workspace root (the sandbox could re-point or create it); refusing"
			return 1
		else
			cfgp+=("$1") # a symlink / missing: its top-level ancestor is ro-bound below (ANCESTORS)
		fi
	}
	hpe=("$home")
	if hh="$(getent passwd "$(id -u)" | cut -d: -f6)" && [[ -n "$hh" && -d "$hh" ]]; then
		hh="$(cd -P "$hh" && pwd)" && [[ "$hh" != "$home" ]] && hpe+=("$hh")
	fi
	local -a hprune=() hrp=()
	# -path takes a pattern: a path with glob characters is not pruned (that only costs time)
	[[ "$repo" == *[][*?\\]* ]] || hrp=(-o -path "$repo")
	for hh in "${hpe[@]}"; do
		[[ "$hh" == / ]] && continue
		hsr+=("$hh/")
		[[ "$hh" == *[][*?\\]* ]] || hprune+=(-o -path "$hh/.cache" -o -path "$hh/go/src" -o -path "$hh/go/pkg")
	done
	for hh in "${XDG_CONFIG_HOME:-}" "${XDG_DATA_HOME:-}" "${ZDOTDIR:-}"; do
		[[ "$hh" == /* && -d "$hh" ]] && hxr+=("$hh/")
	done
	for hh in "${hpe[@]}"; do
		for hl2 in .config .config/systemd/user .local/share .local/bin .ssh .gnupg; do
			[[ -L "$hh/$hl2" && -d "$hh/$hl2" ]] && hxr+=("$hh/$hl2/")
		done
	done
	local -a hpath=()
	IFS=: read -ra hpath <<<"${PATH:-}"
	for hl2 in "${hpath[@]}"; do
		for hh in "${hpe[@]}"; do
			[[ "$hl2" == "$hh"/* && -d "$hl2" ]] && hxr+=("$hl2/")
		done
	done
	hw="$(mktemp)"
	herr2="$(mktemp)"
	{
		[[ ${#hsr[@]} -eq 0 ]] || LC_ALL=C find -H "${hsr[@]}" -ignore_readdir_race -maxdepth "$PA_SANDBOX_HOME_DEPTH" \( -name .git -o -name node_modules "${hrp[@]}" "${hprune[@]}" \) -prune -o -type l -printf '%p\0%l\0'
		[[ ${#hxr[@]} -eq 0 ]] || LC_ALL=C find -H "${hxr[@]}" -ignore_readdir_race -maxdepth "$PA_SANDBOX_HOME_DEPTH" \( -name .git -o -name node_modules "${hrp[@]}" \) -prune -o -type l -printf '%p\0%l\0'
	} >"$hw" 2>"$herr2" || true
	# an entry removed while it is scanned (ENOENT; LC_ALL=C above keeps the message fixed) is
	# simply gone, not unreadable: not reported
	herrs="$(grep -v 'No such file or directory' "$herr2" | head -c 300 | tr '\n' ' ' || true)"
	if [[ -n "$herrs" ]]; then
		pa_sandbox_warn "HOME symlink scan: some entries could not be read (skipped; this uid cannot read them either): $herrs"
	fi
	command rm -f "$herr2"
	while IFS= read -r -d '' hp && IFS= read -r -d '' ht; do
		[[ -z "${hseen[$hp]:-}" ]] || continue
		hseen[$hp]=1
		hcnt=$((hcnt + 1))
		_rw "$hp" && continue # a state-dir entry, scrubbed (not a host HOME entry)
		hrl[$hp]="$ht"
		hpend+=("$hp")
	done <"$hw"
	command rm -f "$hw"
	if [[ $hcnt -gt $PA_SANDBOX_MAX_HOME_LINKS ]]; then
		pa_sandbox_die "$hcnt symlinks under HOME, more than PA_SANDBOX_MAX_HOME_LINKS ($PA_SANDBOX_MAX_HOME_LINKS); refusing (raise it to accept)"
		return 1
	fi
	# bind mounts below a home (e.g. a container mounting <checkout>/gitconfig on ~/.gitconfig):
	# the source is visible at <mount point of the same fs> + (its root - that mount's root)
	local -a mdev=() mroot=() mtgt=()
	local f3 f4 f5
	while read -r _ _ f3 f4 f5 _; do
		f4="${f4//\\/\\0}"
		f5="${f5//\\/\\0}"
		printf -v f4 '%b' "$f4"
		printf -v f5 '%b' "$f5"
		mdev+=("$f3")
		mroot+=("$f4")
		mtgt+=("$f5")
	done </proc/self/mountinfo
	for i in "${!mtgt[@]}"; do
		[[ "${mroot[$i]}" == *//deleted ]] && continue
		mi=0
		for hh in "${hpe[@]}"; do
			[[ "${mtgt[$i]}" == "$hh"/* ]] && mi=1
		done
		[[ $mi -eq 1 ]] || continue
		for j in "${!mtgt[@]}"; do
			[[ $j -ne $i && "${mdev[$j]}" == "${mdev[$i]}" ]] || continue
			mr="${mroot[$j]%/}"
			[[ "${mroot[$i]}" == "$mr"/* || "${mroot[$i]}" == "${mroot[$j]}" ]] || continue
			hp="${mtgt[$j]%/}${mroot[$i]#"$mr"}"
			hp="${hp:-/}"
			hlab[$hp]="bind mount ${mtgt[$i]}"
			hpend+=("$hp")
		done
	done
	# walk every entry; uncached link targets are read in one batch per round (no fork per hop)
	for ((k = 0; k <= 41 && ${#hpend[@]} > 0; k++)); do
		hneed=()
		hnext=()
		for hp in "${hpend[@]}"; do
			hr=0
			_hwalk "$hp" || hr=$?
			if [[ $hr -eq 3 && $k -lt 41 ]]; then
				hnext+=("$hp")
				continue
			fi
			# the hops recorded so far are checked first (their refusals are more specific)
			for hl2 in "${hmid[@]}"; do
				_hprot "$hl2" 1 "${hlab[$hp]:-$hp}" || return 1
			done
			if [[ $hr -ne 0 ]]; then
				# rc 1 (a newline in the path or a link target, more than 40 links, an unreadable or
				# vanished link) or still unresolved after the last round: pa-sandbox cannot tell
				# what the host reads through it, so it can neither protect nor accept it
				pa_sandbox_die "${hlab[$hp]:-$hp} cannot be resolved (a newline in its path or a link target, a loop of more than 40 links, or a link that cannot be read): the host might read a workspace file through it that cannot be protected; refusing"
				return 1
			fi
			_hprot "$hq" 0 "${hlab[$hp]:-$hp}" || return 1
			for hl2 in "${hdot[@]}"; do
				_hdot "$hl2" "${hlab[$hp]:-$hp}" "$hq" "${hmid[@]}" || return 1
			done
		done
		hpend=("${hnext[@]}")
		[[ ${#hneed[@]} -gt 0 ]] || continue
		for hl2 in "${hneed[@]}"; do hrl[$hl2]=""; done # vanished meanwhile: unresolvable
		hw="$(mktemp)"
		find -P "${hneed[@]}" -maxdepth 0 -printf '%p\0%l\0' >"$hw" 2>/dev/null || true
		while IFS= read -r -d '' hl2 && IFS= read -r -d '' ht; do
			hrl[$hl2]="$ht"
		done <"$hw"
		command rm -f "$hw"
	done
	if [[ ${#hfiles[@]} -gt 0 ]]; then
		if ! hw="$(stat -c '%h %d:%i' -- "${hfiles[@]}")"; then
			pa_sandbox_die "cannot stat the HOME-referenced workspace files; refusing"
			return 1
		fi
		mapfile -t hst <<<"$hw"
		for i in "${!hfiles[@]}"; do
			[[ "${hst[$i]%% *}" -le 1 ]] || hl+=("${hst[$i]#* }"$'\t'"${hfiles[$i]}")
		done
	fi
	if [[ $hnro -gt 0 ]]; then
		pa_sandbox_warn "$hnro host file(s) reached through HOME (symlinks / bind mounts) resolve into the workspace and are read-only inside the sandbox (with their top-level directory), e.g.: ${hex[*]}"
	fi
	# `..` IN GIT PATHS (see header): now that every protection is known, a directory a git path
	# left through `..` must lie in a protected path or in a top-level directory that ANCESTORS
	# ro-binds below (that of any protected path, gitfile or missing reference)
	local pg rel top
	for pg in "${gdot[@]}"; do
		_hdot "${pg%%$'\t'*}" "${pg#*$'\t'}" "${prot[@]}" "${gfiles[@]}" "${cfgp[@]}" || return 1
	done
	# ANCESTORS (see header): ro-bind the top-level ancestor of every protected git path
	# below the root, so no writable parent can be renamed to move the mount away.
	local -a anc=()
	for pg in "${prot[@]}" "${gfiles[@]}" "${cfgp[@]}"; do
		pa_sandbox_within "$pg" "$repo" || continue
		rel="${pg#"$repo"/}"
		if [[ "$rel" != */* ]]; then # directly under the root: itself a mount point already
			[[ "$rel" == .git || -n "${seen[$repo/$rel/]:-}" ]] || {
				seen[$repo/$rel/]=1
				anc+=("$rel")
			}
			continue
		fi
		top="$repo/${rel%%/*}"
		if [[ ! -d "$top" || -L "$top" ]]; then
			pa_sandbox_die "cannot protect '$top' (ancestor of git path '$pg'): not a real directory; refusing"
			return 1
		fi
		[[ -n "${seen[$top]:-}" ]] || anc+=("${rel%%/*}/")
		_ro "$top"
	done
	if [[ ${#anc[@]} -gt 0 ]]; then
		pa_sandbox_warn "read-only inside the sandbox (they contain protected git metadata or host files reached through HOME; edits there fail by design): ${anc[*]}"
	fi
	# HARD LINKS (see header): a protected file whose inode also has a name that stays
	# writable inside (the workspace outside every ro bind, an rw state path) refuses.
	if [[ ${#hl[@]} -gt 0 ]]; then
		local e hp s okp hlst herr
		local -A hid=()
		local -a hroots=()
		for e in "${hl[@]}"; do hid[${e%%$'\t'*}]="${e#*$'\t'}"; done
		for e in "${rwp[@]}"; do [[ -e "$e" ]] && hroots+=("$e"); done
		hlst="$(mktemp)"
		herr="$(mktemp)"
		frc=0
		find -P "${hroots[@]}" -type f -links +1 -printf '%D:%i\t%p\0' >"$hlst" 2>"$herr" || frc=$?
		if [[ $frc -ne 0 || -s "$herr" ]]; then
			pa_sandbox_die "scan for hard links failed (rc=$frc): $(head -c 400 "$herr"); refusing"
			command rm -f "$hlst" "$herr"
			return 1
		fi
		command rm -f "$herr"
		# shellcheck disable=SC2094 # the rm in the refusal branch runs right before `return`
		while IFS= read -r -d '' e; do
			[[ -n "${hid[${e%%$'\t'*}]:-}" ]] || continue
			hp="${e#*$'\t'}"
			okp=0
			if pa_sandbox_within "$hp" "$repo"; then
				for s in "${!seen[@]}"; do
					[[ "$s" != */ ]] && pa_sandbox_within "$hp" "$s" && okp=1 && break
				done
			fi
			if [[ $okp -ne 1 ]]; then
				pa_sandbox_die "hard-linked git control file or HOME-referenced file '${hid[${e%%$'\t'*}]}' is the same file as '$hp', which is writable inside the sandbox; refusing"
				command rm -f "$hlst"
				return 1
			fi
		done <"$hlst"
		command rm -f "$hlst"
	fi
	unset -f _ro _rw _hl _walk _vexpose _vpath _into_ws _protect_dir _protect_path _abs _cfg_read _scan_links _wsplit _words _wx _wadd _pp _cand _nonpath _git_ctx _sub_ctx _gmem _hwalk _hprot _hdot

	PA_BWRAP_ARGV+=(--dir /tmp/pa-sandbox --clearenv --setenv HOME "$home")
	local -a pass=()
	read -ra pass <<<"${PA_SANDBOX_PASS_ENV:-}" # no globbing: read -ra splits only on IFS
	for name in "${PA_SANDBOX_ENV_ALLOW[@]}" "${pass[@]}"; do
		[[ "$name" == TMPDIR ]] && PA_BWRAP_ARGV+=(--setenv TMPDIR /tmp) && continue # see the header (Environment)
		[[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ && -n "${!name+x}" ]] && PA_BWRAP_ARGV+=(--setenv "$name" "${!name}")
	done
	# compgen -e lists exported variable NAMES only, so multi-line values are safe.
	while IFS= read -r name; do
		case "$name" in
		LC_* | PRIME_AGENT_*) PA_BWRAP_ARGV+=(--setenv "$name" "${!name}") ;;
		esac
	done < <(compgen -e)
	# Fixed values last (bwrap: later --setenv wins).
	PA_BWRAP_ARGV+=(
		--setenv GIT_CONFIG_NOSYSTEM 1
		--setenv PRIME_AGENT_CODING_AGENT_DIR "$agent_dir"
		--setenv PRIME_AGENT_DAEMON_SOCKET /tmp/pa-sandbox/daemon.sock
		--setenv PRIME_AGENT_BASH_COMMAND_PREFIX "$PA_SANDBOX_GUARD_PREFIX"
		--chdir "$repo"
		--
	)
}

# pa_sandbox_verify_guard: run the built profile (PA_BWRAP_ARGV) with the same
# `bash -c` shape prime-agent uses and prove, INSIDE the sandbox, that the guard
# loads, allows a harmless command, and refuses a known-blocked one with rc 126.
# `. guard` failing is non-fatal in bash, so without this a hidden guard would
# silently leave every command unguarded.
pa_sandbox_verify_guard() {
	[[ "${PA_SANDBOX_ALLOW_NO_GUARD:-0}" == 1 ]] && return 0
	local script out rc
	_probe() { # <command>
		script=$'exec 9>&0 8>&1 0</dev/null\nread -r _g <&9 || exit 127\n{\n'"$PA_SANDBOX_GUARD_PREFIX"$'\n'"$1"$'\n} 8>&- 9>&-\n__s=$?\nexit $__s'
		out="$(echo go | "${PA_BWRAP_ARGV[@]}" bash -c "$script" 2>&1)" && rc=0 || rc=$?
		# bwrap's own setup errors ("bwrap: Can't find source path ...") mean the sandbox never
		# started (e.g. a path the profile names vanished on the host meanwhile): say so instead
		# of blaming the guard
		# (rc 2: pa_sandbox_main retries the whole launch; PA_SANDBOX_SETUP_ERR says why)
		if [[ $rc -ne 0 && "$out" == bwrap:* ]]; then
			PA_SANDBOX_SETUP_ERR="bwrap rc=$rc; the guard probe did not run: $out"
			return 2
		fi
	}
	_probe 'echo PA-PROBE-ALLOWED' || return $?
	if [[ $rc -ne 0 || "$out" != *PA-PROBE-ALLOWED* ]]; then
		pa_sandbox_die "guard probe failed inside the sandbox (allowed command did not run, rc=$rc): $out"
		return 1
	fi
	_probe 'echo PA-PROBE-LEAK; r''m -rf ~' || return $?
	if [[ $rc -ne 126 || "$out" == *PA-PROBE-LEAK* ]]; then
		pa_sandbox_die "guard probe failed inside the sandbox (blocked command was not refused with rc 126, rc=$rc): $out"
		return 1
	fi
	return 0
}

# The rw state dirs are later written by an UNSANDBOXED daemon, which would follow a
# planted symlink (or open a planted FIFO/device) and write wherever it points.
# Remove every non-regular, non-directory entry there, at launch and after exit.
# Directories the sandbox made unreadable (0111/000) would hide planted entries from
# find, so real directories are first normalised to u+rwx (never following symlinks;
# chmod runs per directory BEFORE find descends into it). Every find error, in either
# step, fails the scrub (rc 1): at launch pa-sandbox refuses to start, at exit the
# run fails.
pa_sandbox_scrub_state() { # <agent_dir>
	local name d n pass errf frc clean
	errf="$(mktemp)"
	for name in "${PA_SANDBOX_AGENT_RW_DIRS[@]}"; do
		d="$1/$name"
		[[ -d "$d" && ! -L "$d" ]] || continue
		clean=0
		for pass in 1 2 3 4 5 6 7 8; do
			frc=0
			find -P "$d" -type d ! -perm -u=rwx -exec chmod u+rwx {} \; >/dev/null 2>"$errf" || frc=$?
			if [[ $frc -eq 0 && ! -s "$errf" ]]; then
				clean=1
				break
			fi
		done
		if [[ $clean -ne 1 ]]; then
			pa_sandbox_warn "cannot normalise directory permissions under $d: $(head -c 400 "$errf")"
			command rm -f "$errf"
			return 1
		fi
		frc=0
		n="$(find -P "$d" \( -type l -o -type p -o -type s -o -type b -o -type c \) -print -delete 2>"$errf" | wc -l)" || frc=$?
		if [[ $frc -ne 0 || -s "$errf" ]]; then
			pa_sandbox_warn "scrub of $d failed: $(head -c 400 "$errf")"
			command rm -f "$errf"
			return 1
		fi
		[[ "$n" -gt 0 ]] && pa_sandbox_warn "removed $n planted symlink/special entries under $d"
	done
	command rm -f "$errf"
	return 0
}

# PIDs whose ipc namespace equals <ipc id> AND whose user namespace is <user ns id> or
# a DESCENDANT of it (the sandbox's payload runs in a user ns nested inside the one
# bwrap created, because of --disable-userns). Ancestry is read from the kernel
# (NS_GET_PARENT), so a victim in an unrelated user ns can never match.
pa_sandbox_members() { # <ipc id> <user ns id>
	python3 -I -c '
import fcntl, os, sys
NS_GET_PARENT = 0xB702
want_i, want_u = sys.argv[1], sys.argv[2]
out = []
for e in os.listdir("/proc"):
    if not e.isdigit():
        continue
    try:
        if os.readlink("/proc/%s/ns/ipc" % e) != want_i:
            continue
        fd = os.open("/proc/%s/ns/user" % e, os.O_RDONLY)
    except OSError:
        continue
    try:
        for _ in range(32):
            if os.readlink("/proc/self/fd/%d" % fd) == want_u:
                out.append(e)
                break
            try:
                nfd = fcntl.ioctl(fd, NS_GET_PARENT, 0)
            except OSError:
                break
            os.close(fd)
            fd = nfd
    finally:
        try:
            os.close(fd)
        except OSError:
            pass
print(" ".join(out))
' "$1" "$2"
}

# Kill every member (see pa_sandbox_members) and wait until none is left. Never runs
# against pa-sandbox's own namespaces.
pa_sandbox_sweep() { # <ipc id> <user ns id>
	local me_i me_u pid pids n deadline
	me_i="$(readlink /proc/self/ns/ipc)"
	me_u="$(readlink /proc/self/ns/user)"
	if [[ ! "$1" =~ ^ipc:\[[0-9]+\]$ || ! "$2" =~ ^user:\[[0-9]+\]$ || "$1" == "$me_i" || "$2" == "$me_u" ]]; then
		pa_sandbox_warn "sandbox namespace identity '$1' '$2' unusable; cannot sweep leftover processes"
		return 1
	fi
	deadline=$((SECONDS + 5))
	while :; do
		pids="$(pa_sandbox_members "$1" "$2")" || {
			pa_sandbox_warn "member scan failed; cannot verify the sandbox is empty"
			return 1
		}
		n=0
		for pid in $pids; do
			kill -9 "$pid" 2>/dev/null || true
			n=$((n + 1))
		done
		[[ $n -eq 0 ]] && return 0
		if [[ $SECONDS -ge $deadline ]]; then
			pa_sandbox_warn "$n process(es) still alive in the sandbox after SIGKILL"
			return 1
		fi
		sleep 0.05
	done
}

# Host-side watcher (background): learn the sandbox child's namespace ids from the
# host while bwrap holds the child blocked, then release it. bwrap's child reads --block-fd
# only AFTER its own setup (measured, bubblewrap 0.12.0), and a child whose setup fails exits
# without reading it, so until the watcher writes to block-fd nothing has run inside.
# Ids that cannot be read come from a child that is exiting or gone: an exited child that
# bwrap's monitor has not reaped yet (a zombie) has no /proc/<pid>/ns/ipc (ENOENT) while
# /proc/<pid> itself remains (measured: about 0.6-0.7 ms after a real setup failure). The
# watcher then keeps block-fd unreleased and polls until /proc/<pid> is gone, at most 250
# polls 0.02 s apart (at least 5 s, the sweep's deadline; 6.5 s measured with the fork cost of
# each poll): the monitor normally reaps within a millisecond, so the bound only matters
# when the host stalls it, and a launch never hangs on it. Gone = the child died before it
# was released, so nothing ran inside: recorded as `exited` (pa_sandbox_main retries without
# a sweep). If ns/ipc becomes readable while waiting, or /proc/<pid> is still there at the
# bound, nothing is recorded: block-fd is then released as before and pa_sandbox_main
# reports the unrecorded identity with rc 70, no retry.
# PID reuse: the kernel frees a pid only when its zombie is reaped, so /proc/<pid> cannot be
# absent while the child exists (zombie or not) -- `exited` is never written for a live child.
# After the reap the pid may be reused by another process: that can keep /proc/<pid> present
# (up to the bound) or make its ns readable, and both end with no record; an `exited` written
# once it is absent again is still true (our child was reaped before). The wait never reads
# ids, so it adds no way to record another process's namespaces.
pa_sandbox_watch() { # <rundir>
	local d="$1" i line pid="" ipc="" usr=""
	for ((i = 0; i < 400; i++)); do
		line="$(cat "$d/info" 2>/dev/null || true)"
		if [[ "$line" =~ \"child-pid\":[[:space:]]*([0-9]+)[,}[:space:]] ]]; then
			pid="${BASH_REMATCH[1]}"
			break
		fi
		sleep 0.05
	done
	if [[ -n "$pid" ]]; then
		if ipc="$(readlink "/proc/$pid/ns/ipc" 2>/dev/null)" && usr="$(readlink "/proc/$pid/ns/user" 2>/dev/null)"; then
			printf '%s\n%s\n' "$ipc" "$usr" >"$d/record.tmp" && mv "$d/record.tmp" "$d/record"
		else
			for ((i = 0; i < 250; i++)); do # exit wait (see above)
				if [[ ! -e "/proc/$pid" ]]; then
					printf 'exited\n' >"$d/record.tmp" && mv "$d/record.tmp" "$d/record"
					break
				fi
				readlink "/proc/$pid/ns/ipc" >/dev/null 2>&1 && break
				sleep 0.02
			done
		fi
	fi
	exec 9<>"$d/block"
	printf x >&9
}

# One-shot sweep from the recorded identity. rc 0 = clean, 1 = failed/unknown.
pa_sandbox_sweep_recorded() {
	[[ "${PA_SANDBOX_SWEPT:-0}" == 1 ]] && return 0
	PA_SANDBOX_SWEPT=1
	local ipc usr
	if [[ ! -s "${PA_SANDBOX_RUNDIR:-/nonexistent}/record" ]]; then
		pa_sandbox_warn "sandbox namespace identity was not recorded; cannot sweep leftover processes"
		return 1
	fi
	{ read -r ipc && read -r usr; } <"$PA_SANDBOX_RUNDIR/record" || true
	pa_sandbox_sweep "${ipc:-}" "${usr:-}"
}

# Final cleanup (EXIT trap): sweep if a launch is pending (INT/TERM), scrub state, drop the
# private temp dir (it holds every run dir).
pa_sandbox_cleanup() {
	local rc=0
	[[ -n "${PA_SANDBOX_WATCHER:-}" ]] && kill "$PA_SANDBOX_WATCHER" 2>/dev/null || true
	if [[ -n "${PA_SANDBOX_RUNDIR:-}" ]]; then
		pa_sandbox_sweep_recorded || rc=70
	fi
	if [[ -n "${PA_SANDBOX_SCRUB_DIR:-}" ]]; then
		pa_sandbox_scrub_state "$PA_SANDBOX_SCRUB_DIR" || true # main already reported; this covers INT/TERM
	fi
	[[ -n "${PA_SANDBOX_TMP:-}" ]] && command rm -rf "$PA_SANDBOX_TMP"
	return "$rc"
}

# PRIVATE TEMP DIR: everything pa-sandbox decides on (the run dir's record, started, bwrap.err,
# info; the profile scans' lists; the scrub's error file) lives in one dir created as
# /tmp/pa-sandbox.XXXXXXXXXX, never under the caller's $TMPDIR, which may lie in the workspace
# or another path the sandbox can write. Inside the sandbox /tmp is an empty tmpfs, so that dir
# is not there. pa_sandbox_tmp_hidden checks this against the built profile (PA_BWRAP_ARGV):
# no bind source or destination (canonical or as given) may be the dir, inside it or an ancestor
# of it -- except the root `--ro-bind / /`, which must then be covered by a later --tmpfs that is
# an ancestor of the dir. An option it does not know fails closed.
pa_sandbox_tmp_hidden() { # <canonical dir>
	local p="$1" i=1 n=${#PA_BWRAP_ARGV[@]} op a b c covered=0
	[[ "${PA_BWRAP_ARGV[0]:-}" == bwrap ]] || return 1
	while [[ $i -lt $n ]]; do
		op="${PA_BWRAP_ARGV[$i]}"
		case "$op" in
		--) break ;;
		--bind | --bind-try | --ro-bind | --ro-bind-try | --dev-bind | --dev-bind-try)
			a="${PA_BWRAP_ARGV[$((i + 1))]:-}"
			b="${PA_BWRAP_ARGV[$((i + 2))]:-}"
			i=$((i + 3))
			if [[ "$a" == / && "$b" == / ]]; then
				covered=0
				continue
			fi
			for c in "$a" "$b" "$(readlink -f -- "$a" 2>/dev/null)" "$(readlink -f -- "$b" 2>/dev/null)"; do
				[[ -n "$c" ]] || continue
				if pa_sandbox_within "$p" "$c" || pa_sandbox_within "$c" "$p"; then
					pa_sandbox_die "the private temp dir $p would be visible inside the sandbox ($op $a $b); refusing"
					return 1
				fi
			done
			;;
		--tmpfs | --dir | --dev | --proc | --chdir | --info-fd | --block-fd)
			a="${PA_BWRAP_ARGV[$((i + 1))]:-}"
			i=$((i + 2))
			[[ "$op" == --tmpfs && "$a" != / ]] && pa_sandbox_within "$p" "$a" && covered=1
			;;
		--setenv)
			i=$((i + 3))
			;;
		--unshare-user | --unshare-ipc | --unshare-uts | --unshare-pid | --disable-userns | \
			--assert-userns-disabled | --die-with-parent | --new-session | --clearenv)
			i=$((i + 1))
			;;
		*)
			pa_sandbox_die "cannot tell whether bwrap option '$op' exposes the private temp dir; refusing"
			return 1
			;;
		esac
	done
	if [[ $covered -ne 1 ]]; then
		pa_sandbox_die "the private temp dir $p is not under a sandbox tmpfs (it would be visible inside); refusing"
		return 1
	fi
}

# A launch whose bwrap setup fails because a host path the profile names vanished in the
# meantime (the agent dir is listed when the profile is built; bwrap checks a
# --ro-bind-try source and mounts it a moment later) has run nothing inside: it is retried
# with a freshly built profile, up to PA_SANDBOX_SETUP_TRIES (3) launches in all. The real
# run tells this case apart through the sh shim below: bwrap's OWN stderr goes to
# <rundir>/bwrap.err (shown afterwards), and the shim, before exec'ing prime-agent, marks
# <rundir>/started and hands prime-agent the real stderr; fds 3 and 4 are closed before
# prime-agent runs, and the run dir is in the PRIVATE TEMP DIR (not inside the sandbox,
# pa_sandbox_tmp_hidden), so nothing inside can reach any file there.
# A launch counts as a setup failure only if bwrap failed (rc != 0) with its own message
# (bwrap.err starts with `bwrap:`) and started is empty. Then:
#   - the record says nothing can be left: `exited` (the child was gone before the watcher
#     released it) or no record because bwrap never created a child (no child-pid in info):
#     the sweep is skipped and the launch is retried;
#   - the record holds namespace ids (the watcher read them while the child was still in
#     bwrap's setup, which then failed): those ids are swept first, and the launch is retried
#     only if that sweep succeeds (no member left alive).
# In every other case the recorded sandbox is swept and the launch is not retried. A failed
# sweep (no record, an unusable identity, a member left alive) is reported with rc 70 and
# ends the launch without a retry, in every case. Before a retry the previous run dir is
# removed (a failure to remove it ends with rc 70); bwrap has exited and the sweep found no
# member, so no process, and no mount (they live in the sandbox's own mount namespace), of
# the previous attempt is left.
pa_sandbox_main() {
	pa_sandbox_require_bwrap || return $?
	local repo agent_dir rc=0 vrc try tries="$PA_SANDBOX_SETUP_TRIES" setupfail rec
	PA_SANDBOX_RUNDIR="" PA_SANDBOX_SCRUB_DIR="" PA_SANDBOX_WATCHER="" PA_SANDBOX_TMP=""
	trap 'pa_sandbox_cleanup' EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM
	PA_SANDBOX_TMP="$(mktemp -d /tmp/pa-sandbox.XXXXXXXXXX)" || {
		PA_SANDBOX_TMP=""
		pa_sandbox_die "cannot create a private temp dir under /tmp; refusing"
		return 1
	}
	if [[ "$(cd -P "$PA_SANDBOX_TMP" 2>/dev/null && pwd)" != "$PA_SANDBOX_TMP" ]]; then
		pa_sandbox_die "$PA_SANDBOX_TMP resolves elsewhere (/tmp is not a plain directory); refusing"
		return 1
	fi
	local -a passenv=()
	read -ra passenv <<<"${PA_SANDBOX_PASS_ENV:-}"
	if [[ " ${passenv[*]} " == *" TMPDIR "* && -n "${TMPDIR:-}" && "$TMPDIR" != /tmp ]]; then
		pa_sandbox_warn "PA_SANDBOX_PASS_ENV: TMPDIR is /tmp inside the sandbox (its own tmpfs), not '$TMPDIR'"
	fi
	export TMPDIR="$PA_SANDBOX_TMP" # every mktemp below (profile scans, scrub) lands there
	repo="$(pa_sandbox_repo_root "$PWD")"
	[[ "${PA_SANDBOX_ALLOW_NO_GUARD:-0}" == 1 ]] && pa_sandbox_warn "UNSAFE: PA_SANDBOX_ALLOW_NO_GUARD=1, guard verification skipped, commands run unguarded"
	for ((try = 1; ; try++)); do
		pa_sandbox_build_argv "$repo" || return $?
		pa_sandbox_tmp_hidden "$PA_SANDBOX_TMP" || return 1
		agent_dir="$(cd -P "$HOME/.prime/agent" && pwd)"
		pa_sandbox_scrub_state "$agent_dir" || {
			pa_sandbox_die "state scrub failed at launch; refusing to start"
			return 1
		}
		vrc=0
		pa_sandbox_verify_guard || vrc=$?
		if [[ $vrc -eq 2 ]]; then
			if [[ $try -lt $tries ]]; then
				pa_sandbox_warn "sandbox setup failed (a host path changed while starting), retrying: $PA_SANDBOX_SETUP_ERR"
				continue
			fi
			pa_sandbox_die "cannot start the sandbox ($PA_SANDBOX_SETUP_ERR)"
			return 1
		fi
		[[ $vrc -eq 0 ]] || return "$vrc"
		PA_SANDBOX_SCRUB_DIR="$agent_dir" # globals: locals are gone when the EXIT trap fires
		PA_SANDBOX_SWEPT=0
		PA_SANDBOX_RUNDIR="$(mktemp -d "$PA_SANDBOX_TMP/run.XXXXXX")"
		mkfifo "$PA_SANDBOX_RUNDIR/block"
		: >"$PA_SANDBOX_RUNDIR/started"
		PA_BWRAP_ARGV=("${PA_BWRAP_ARGV[@]:0:${#PA_BWRAP_ARGV[@]}-1}" --info-fd 7 --block-fd 8 --)
		pa_sandbox_watch "$PA_SANDBOX_RUNDIR" &
		PA_SANDBOX_WATCHER=$!
		rc=0
		# shellcheck disable=SC2016 # expanded by the shim's sh inside
		"${PA_BWRAP_ARGV[@]}" /bin/sh -c 'printf x >&4 || exit 125; exec 2>&3 3>&- 4>&-; exec prime-agent "$@"' prime-agent "$@" \
			3>&2 4>"$PA_SANDBOX_RUNDIR/started" 2>"$PA_SANDBOX_RUNDIR/bwrap.err" \
			7>"$PA_SANDBOX_RUNDIR/info" 8<>"$PA_SANDBOX_RUNDIR/block" || rc=$?
		[[ -s "$PA_SANDBOX_RUNDIR/bwrap.err" ]] && cat "$PA_SANDBOX_RUNDIR/bwrap.err" >&2
		# bwrap is gone, so info is final: without a child-pid the watcher has nothing to record
		grep -q '"child-pid"' "$PA_SANDBOX_RUNDIR/info" 2>/dev/null || kill "$PA_SANDBOX_WATCHER" 2>/dev/null || true
		wait "$PA_SANDBOX_WATCHER" 2>/dev/null || true
		PA_SANDBOX_WATCHER=""
		setupfail=0
		if [[ $rc -ne 0 && ! -s "$PA_SANDBOX_RUNDIR/started" && "$(head -c 6 "$PA_SANDBOX_RUNDIR/bwrap.err")" == bwrap: ]]; then
			rec="$(head -c 16 "$PA_SANDBOX_RUNDIR/record" 2>/dev/null || true)"
			if [[ "$rec" == exited ]] || { [[ ! -e "$PA_SANDBOX_RUNDIR/record" ]] && ! grep -q '"child-pid"' "$PA_SANDBOX_RUNDIR/info" 2>/dev/null; }; then
				setupfail=1
			elif [[ -s "$PA_SANDBOX_RUNDIR/record" ]]; then
				setupfail=2 # ids recorded: retried only if the sweep below succeeds
			fi
		fi
		# sweep now (not only in the trap) so a failure can change the return code
		if [[ $setupfail -eq 1 ]]; then
			PA_SANDBOX_SWEPT=1 # nothing ran inside: no sandbox process to sweep
		elif ! pa_sandbox_sweep_recorded; then
			pa_sandbox_die "sandbox processes could not be cleaned up; state may be tainted" 70 || true
			rc=70
			break
		fi
		if [[ $setupfail -ne 0 && $try -lt $tries ]]; then
			# drop this attempt's run state and start over
			command rm -rf "$PA_SANDBOX_RUNDIR"
			if [[ -e "$PA_SANDBOX_RUNDIR" ]]; then
				pa_sandbox_die "cannot remove the previous run dir $PA_SANDBOX_RUNDIR; not retrying" 70 || true
				rc=70
				break
			fi
			PA_SANDBOX_RUNDIR=""
			pa_sandbox_warn "sandbox setup failed (a host path changed while starting), retrying"
			continue
		fi
		break
	done
	if ! pa_sandbox_scrub_state "$PA_SANDBOX_SCRUB_DIR"; then
		pa_sandbox_die "post-exit state scrub failed; planted entries may remain in the rw state dirs" 71 || true
		[[ $rc -eq 0 ]] && rc=71
	fi
	return "$rc"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	pa_sandbox_main "$@"
fi
