emulate -L zsh
local name="$1"
local defer=$2
local cmd="$3"
local cache_file="$ZCACHE_DIR/${name}.zsh"
shift 3

# defer=-1: force regenerate + synchronous zcompile + no source (used by zprecompile)
local need_eval=0
if (( defer == -1 )) || [[ ! -f "$cache_file" ]]; then
	need_eval=1
else
	for d in "$@"; do
		if [[ -n "$d" && "$d" -nt "$cache_file" ]]; then
			need_eval=1
			break
		fi
	done
fi

if (( need_eval )); then
	# Absolute paths: this runs from zsh/00-env.zsh right after PATH="" on Darwin,
	# so PATH-dependent lookups of these external commands (mkdir/mv/rmdir) fail
	# silently and the cache is never written, leaving PATH stuck empty/broken.
	# Stale-lock takeover and the timeout fallback below are best-effort, not
	# strictly atomic (a second process could see "stale" and race to rmdir/mkdir
	# at the same moment, or a timed-out waiter's write could land after the
	# original holder's). This is accepted: $cmd is deterministic for a given
	# input set, so the worst case is redundant regeneration/a last-writer-wins
	# overwrite with equivalent content, not corruption -- and a fully atomic
	# lock (e.g. lockfile+PID+fcntl) would add real cost to a startup-critical path.
	local stale=(${cache_file}.lock(Nms+30))
	if (( ${#stale} > 0 )); then
		/bin/rmdir "${cache_file}.lock" 2>/dev/null
	fi

	if /bin/mkdir "${cache_file}.lock" 2>/dev/null; then
		# Always promote $cmd's stdout, even empty. At least one caller
		# (zsh/10-editor.zsh's nvim_runtime cmd) is a `cond && echo ...` where a
		# false $cond is a legitimate "nothing to cache" result (its
		# Homebrew-runtime-path glob genuinely matching zero paths), not an
		# error -- exit status alone can't tell the two apart, and an empty
		# cache file sources as a harmless no-op either way. Skipping the
		# promotion on a non-zero exit would leave $cache_file missing in that
		# case, making every subsequent invocation re-run $cmd (no caching at
		# all) and then fail at the unconditional `source "$cache_file"` below.
		# PID-suffixed, like the fallback path below: a stale-lock takeover (see
		# the comment above) can put two processes here writing at once, and a
		# shared fixed ".tmp" name would let the second writer's O_TRUNC reset
		# the file length under the first writer's still-in-flight fd, leaving
		# a NUL-hole file behind once whichever write finishes last gets mv'd
		# into place. A unique name per writer keeps each write self-contained,
		# so the accepted risk is genuinely just last-writer-wins (whole $cmd
		# outputs racing at the final mv), not partial-write corruption.
		eval "$cmd" > "${cache_file}.tmp.$$"
		/bin/mv -f "${cache_file}.tmp.$$" "$cache_file" || /bin/rm -f "${cache_file}.tmp.$$" 2>/dev/null
		/bin/rmdir "${cache_file}.lock" 2>/dev/null
		if (( defer == -1 )); then
			zcompile "$cache_file" 2>/dev/null
		else
			zcompile "$cache_file" 2>/dev/null &|
		fi
	else
		local i=0
		while [[ -d "${cache_file}.lock" ]] && (( i < 1200 )); do
			builtin read -t 0.05 </dev/null 2>/dev/null || sleep 0.05 2>/dev/null
			(( i++ ))
		done
		if [[ ! -f "$cache_file" ]]; then
			eval "$cmd" > "${cache_file}.tmp.$$"
			/bin/mv -f "${cache_file}.tmp.$$" "$cache_file" || /bin/rm -f "${cache_file}.tmp.$$" 2>/dev/null
		fi
	fi
fi

(( defer == -1 )) && return

if (( defer )) && (($+functions[zsh-defer])); then
	zsh-defer source "$cache_file"
else
	source "$cache_file"
fi