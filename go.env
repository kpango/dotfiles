GOPATH=/home/kpango/go
GOBIN=/home/kpango/go/bin
GOPRIVATE=*.yahoo.co.jp,github.com/vdaas/vald,github.com/vdaas/vald/apis,github.com/vdaas/vald-client-go
GONOPROXY=*.yahoo.co.jp,github.com/vdaas/vald,github.com/vdaas/vald/apis,github.com/vdaas/vald-client-go
GONOSUMDB=*.yahoo.co.jp,github.com/vdaas/vald,github.com/vdaas/vald/apis,github.com/vdaas/vald-client-go
GOPROXY=https://proxy.golang.org,direct
GOSUMDB=sum.golang.org
GOTOOLCHAIN=auto
GOAMD64=v3
CC=/usr/bin/clang
CXX=/usr/bin/clang++
CGO_ENABLED=1
CGO_CFLAGS=-O3 -DNDEBUG -pipe -fno-ident -fomit-frame-pointer -fno-semantic-interposition -fno-plt -fdata-sections -ffunction-sections -fno-math-errno -fno-trapping-math
CGO_CXXFLAGS=-O3 -DNDEBUG -std=c++23 -pipe -fno-ident -fomit-frame-pointer -fno-semantic-interposition -fvisibility-inlines-hidden -fno-plt -fdata-sections -ffunction-sections -fno-math-errno -fno-trapping-math
CGO_LDFLAGS=-fuse-ld=lld -Wl,-O3 -Wl,--as-needed -Wl,--gc-sections -Wl,--hash-style=gnu -Wl,-z,now
